@page
@model NDDC_Website_2024.Pages.Services.TendersModel
@{
    Layout = "_Layout";
}

<!-- Hero Banner -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
    <div class="max-w-container-max mx-auto text-left">
        <nav class="flex flex-wrap items-center gap-2 mb-4 md:mb-stack-gap text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
            <a class="hover:text-primary transition-colors" href="/">Home</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-on-surface-variant">Services</span>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-primary font-semibold">Tenders & RFPs</span>
        </nav>
        <h1 class="font-display-lg text-3xl sm:text-5xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight">
            Procurement, Tenders & RFPs
        </h1>
        <div class="w-16 sm:w-24 h-1 sm:h-1.5 bg-secondary mt-4 sm:mt-6 rounded-full"></div>
    </div>
</section>

<!-- Content Section -->
<section class="py-12 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto">
    <div class="text-left mb-8">
        <span class="bg-secondary/10 text-secondary text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block">Procurement Portal</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-primary mt-2">Active Procurement & Expression of Interest</h2>
        <p class="text-on-surface-variant/80 text-xs sm:text-sm mt-1">Review active tender opportunities, requests for proposals (RFPs), and procurement guidelines.</p>
    </div>

    <!-- Tenders Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (Model.Tenders != null && Model.Tenders.Any())
        {
            @foreach (var item in Model.Tenders)
            {
                <div class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between text-left">
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
                            <span class="material-symbols-outlined text-2xl">description</span>
                        </div>
                        <div>
                            <span class="bg-surface-container text-primary text-xs font-semibold px-2.5 py-1 rounded-md mb-2 inline-block">@item.Category</span>
                            <h3 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors leading-snug">@item.Title</h3>
                        </div>
                    </div>
                    <div class="pt-6 border-t border-outline-variant/15 mt-6 flex items-center justify-between">
                        <span class="text-xs font-semibold text-secondary flex items-center gap-1"><i class="fa-solid fa-file-pdf"></i> Official RFP Document</span>
                        <a href="@item.DocumentUrl" target="_blank" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-5 py-2.5 rounded-full transition-all inline-flex items-center gap-1 shadow-sm">
                            View Tender <span class="material-symbols-outlined text-xs">arrow_forward</span>
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Demo Tenders Cards when DB table is empty -->
            <div class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-md transition-all flex flex-col justify-between text-left">
                <div class="space-y-4">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-2xl">construction</span>
                    </div>
                    <div>
                        <span class="bg-secondary/10 text-secondary text-xs font-bold px-2.5 py-1 rounded-md mb-2 inline-block">Civil Works</span>
                        <h3 class="text-lg font-bold text-primary leading-snug">Invitation for Pre-Qualification of Contractors for Shore Protection Projects</h3>
                        <p class="text-xs text-on-surface-variant/80 mt-1">Request for Proposals for coastal erosion control across Rivers and Bayelsa States.</p>
                    </div>
                </div>
                <div class="pt-6 border-t border-outline-variant/15 mt-6 flex items-center justify-between">
                    <span class="text-xs text-on-surface-variant/60 font-medium">Ref: NDDC/CW/2026/01</span>
                    <a href="#" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-5 py-2.5 rounded-full transition-all inline-flex items-center gap-1">
                        Download RFP <span class="material-symbols-outlined text-xs">download</span>
                    </a>
                </div>
            </div>

            <div class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-md transition-all flex flex-col justify-between text-left">
                <div class="space-y-4">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-2xl">memory</span>
                    </div>
                    <div>
                        <span class="bg-secondary/10 text-secondary text-xs font-bold px-2.5 py-1 rounded-md mb-2 inline-block">Consultancy / ICT</span>
                        <h3 class="text-lg font-bold text-primary leading-snug">Expression of Interest (EOI) for Digital Infrastructure Upgrade</h3>
                        <p class="text-xs text-on-surface-variant/80 mt-1">Consultancy services for regional data center infrastructure and portal security integration.</p>
                    </div>
                </div>
                <div class="pt-6 border-t border-outline-variant/15 mt-6 flex items-center justify-between">
                    <span class="text-xs text-on-surface-variant/60 font-medium">Ref: NDDC/ICT/2026/04</span>
                    <a href="#" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-5 py-2.5 rounded-full transition-all inline-flex items-center gap-1">
                        Download EOI <span class="material-symbols-outlined text-xs">download</span>
                    </a>
                </div>
            </div>

            <div class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-md transition-all flex flex-col justify-between text-left">
                <div class="space-y-4">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-2xl">water_drop</span>
                    </div>
                    <div>
                        <span class="bg-secondary/10 text-secondary text-xs font-bold px-2.5 py-1 rounded-md mb-2 inline-block">Water & Environment</span>
                        <h3 class="text-lg font-bold text-primary leading-snug">Solar-Powered Water Treatment Plant Installation</h3>
                        <p class="text-xs text-on-surface-variant/80 mt-1">Procurement and installation of community solar water schemes across Abia and Imo States.</p>
                    </div>
                </div>
                <div class="pt-6 border-t border-outline-variant/15 mt-6 flex items-center justify-between">
                    <span class="text-xs text-on-surface-variant/60 font-medium">Ref: NDDC/ENV/2026/09</span>
                    <a href="#" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-5 py-2.5 rounded-full transition-all inline-flex items-center gap-1">
                        Download Tender <span class="material-symbols-outlined text-xs">download</span>
                    </a>
                </div>
            </div>
        }
    </div>
</section>