@page
@model NDDC_Website_2024.Pages.Services.IReports.SuccessModel
@{
    Layout = "_Layout";
}

<!-- Hero Banner -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
    <div class="max-w-container-max mx-auto text-left">
        <nav class="flex flex-wrap items-center gap-2 mb-4 md:mb-stack-gap text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
            <a class="hover:text-primary transition-colors" href="/">Home</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <a class="hover:text-primary transition-colors" href="/Services/IReports/Index">iReports</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-primary font-semibold">Report Status</span>
        </nav>
        <h1 class="font-display-lg text-3xl sm:text-5xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight">
            Submission Confirmation
        </h1>
        <div class="w-16 sm:w-24 h-1 sm:h-1.5 bg-secondary mt-4 sm:mt-6 rounded-full"></div>
    </div>
</section>

<!-- Success Card Container -->
<section class="py-16 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto">
    <div class="max-w-xl mx-auto bg-white rounded-2xl p-8 sm:p-12 border border-outline-variant/20 shadow-xl text-center space-y-6">
        <div class="w-20 h-20 rounded-full bg-green-100 text-green-600 flex items-center justify-center mx-auto text-4xl shadow-sm">
            <i class="fa-solid fa-circle-check"></i>
        </div>
        
        <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-primary">iReport Sent Successfully!</h2>
            <p class="text-on-surface-variant/80 text-sm sm:text-base mt-2 leading-relaxed">
                Thank you for contributing to project monitoring across the Niger Delta. Your field report has been logged and transmitted to the SERVICOM verification desk.
            </p>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a asp-page="Index" class="w-full sm:w-auto bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-sm px-8 py-3.5 rounded-full transition-all duration-300 shadow-md hover:shadow-lg inline-flex items-center justify-center gap-2">
                Back to iReports <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
            <a href="/" class="w-full sm:w-auto border-2 border-primary text-primary hover:bg-primary hover:text-white font-bold text-sm px-8 py-3.5 rounded-full transition-all duration-300 inline-flex items-center justify-center gap-2">
                Go to Home
            </a>
        </div>
    </div>
</section>