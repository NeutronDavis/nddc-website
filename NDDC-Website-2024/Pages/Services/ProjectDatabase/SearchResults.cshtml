@page
@model NDDC_Website_2024.Pages.Services.ProjectDatabase.SearchResultsModel
@{
    Layout = "_Layout";
}

<!-- Hero Banner -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
    <div class="max-w-container-max mx-auto text-left space-y-6">
        <nav class="flex flex-wrap items-center gap-2 text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
            <a class="hover:text-primary transition-colors" href="/">Home</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <a class="hover:text-primary transition-colors" href="/Services/ProjectDatabase/Index">Project Database</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-primary font-semibold">Search Results</span>
        </nav>
        <h1 class="font-display-lg text-3xl sm:text-5xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight">
            Database Search Results
        </h1>
        <div class="w-16 sm:w-24 h-1 sm:h-1.5 bg-secondary mt-4 sm:mt-6 rounded-full"></div>
    </div>
</section>

<!-- Filter Form & Table Section -->
<section class="py-12 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto space-y-8">
    <!-- Filter Card -->
    <div class="bg-white rounded-2xl p-4 sm:p-6 border border-outline-variant/20 shadow-md text-left">
        <form method="post" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-center">
            <div>
                <label for="projectName" class="block text-xs font-bold text-primary uppercase tracking-wider mb-1.5">Project Title</label>
                <input type="text" id="projectName" asp-for="@Model.Project.ProjectName" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/30 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="Enter Project Name">
            </div>
            <div>
                <label for="stateSelect" class="block text-xs font-bold text-primary uppercase tracking-wider mb-1.5">State</label>
                <select id="stateSelect" asp-for="@Model.Project.SID" asp-items="@(new SelectList(Model.States, "SID", "StateName"))" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/30 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white">
                    <option value="0">Select State</option>
                </select>
            </div>
            <div>
                <label for="categorySelect" class="block text-xs font-bold text-primary uppercase tracking-wider mb-1.5">Category</label>
                <select id="categorySelect" asp-for="@Model.Project.PCID" asp-items="@(new SelectList(Model.ProjectCategories, "PCID", "CatName"))" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/30 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white">
                    <option value="0">Select Category</option>
                </select>
            </div>
            <div class="pt-2 sm:pt-6">
                <button type="submit" class="w-full bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-sm px-6 py-3 rounded-xl transition-all duration-300 shadow-md hover:shadow-lg inline-flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-sm">filter_list</span> Refine Search
                </button>
            </div>
        </form>
    </div>

    <!-- Results Table Container -->
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-outline-variant/20 shadow-md text-left space-y-6">
        <div class="border-b border-outline-variant/15 pb-4 flex items-center justify-between">
            <h2 class="text-xl font-bold text-primary">Matching Project Records</h2>
            <span class="text-xs font-semibold text-on-surface-variant/80">Showing database records</span>
        </div>

        <div class="overflow-x-auto rounded-xl border border-outline-variant/20">
            <table class="w-full text-left text-sm">
                <thead class="bg-surface-container text-primary uppercase text-xs font-bold border-b border-outline-variant/20">
                    <tr>
                        <th scope="col" class="px-6 py-4">S/N</th>
                        <th scope="col" class="px-6 py-4">Project Title</th>
                        <th scope="col" class="px-6 py-4">LGA / Location</th>
                        <th scope="col" class="px-6 py-4">State</th>
                        <th scope="col" class="px-6 py-4">Category</th>
                        <th scope="col" class="px-6 py-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/15 text-on-surface">
                    @if (Model.Projects != null && Model.Projects.Any())
                    {
                        foreach (var item in Model.Projects)
                        {
                            <tr class="hover:bg-surface-container-low transition-colors">
                                <td class="px-6 py-4 font-bold text-primary">@item.SrNo</td>
                                <td class="px-6 py-4 font-semibold text-primary">@item.ProjectName</td>
                                <td class="px-6 py-4 text-on-surface-variant">@item.Location</td>
                                <td class="px-6 py-4 text-on-surface-variant">@item.StateName</td>
                                <td class="px-6 py-4 text-on-surface-variant">@item.CatName</td>
                                <td class="px-6 py-4 text-right">
                                    <a asp-page="ProjectDetails" asp-route-pid="@item.PID" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-4 py-2 rounded-full transition-all shadow-sm">View Details</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-on-surface-variant/70 italic">
                                No matching projects found. Please adjust your search criteria above.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>