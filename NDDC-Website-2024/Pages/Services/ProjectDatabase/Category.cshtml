@page
@model NDDC_Website_2024.Pages.Services.ProjectDatabase.CategoryModel
@{
    Layout = "_Layout";
    var categoryName = Model.Category?.CatName ?? "Category Projects";
}

<!-- Hero Banner -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
    <div class="max-w-container-max mx-auto text-left">
        <nav class="flex flex-wrap items-center gap-2 mb-4 md:mb-stack-gap text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
            <a class="hover:text-primary transition-colors" href="/">Home</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <a class="hover:text-primary transition-colors" href="/Services/ProjectDatabase/Index">Project Database</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-primary font-semibold">@categoryName</span>
        </nav>
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 sm:gap-4">
            <div>
                <h1 class="font-display-lg text-2xl sm:text-4xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight break-words">
                    @categoryName
                </h1>
                <div class="w-16 sm:w-24 h-1 sm:h-1.5 bg-secondary mt-2.5 sm:mt-3 rounded-full"></div>
            </div>
            <span class="bg-secondary/10 text-secondary font-extrabold text-xs sm:text-sm md:text-base px-4 sm:px-5 py-2 sm:py-2.5 rounded-full border border-secondary/20 shadow-sm shrink-0">
                @Model.TotalProjects.ToString("N0") Executed Projects
            </span>
        </div>
    </div>
</section>

<!-- Trend Chart Section -->
<section class="py-8 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto">
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-outline-variant/20 shadow-md text-left">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="text-lg font-bold text-primary">Yearly Project Execution Trend</h3>
                <p class="text-xs text-on-surface-variant/80">Historical delivery profile for @categoryName</p>
            </div>
            <span class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-secondary bg-secondary/10 px-3 py-1 rounded-full border border-secondary/20">
                <span class="w-2 h-2 rounded-full bg-secondary"></span> Annual Distribution
            </span>
        </div>
        <div id="chart" class="w-full min-h-[300px]"></div>
    </div>
</section>

<!-- Projects Table Section -->
<section class="pb-16 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto">
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-outline-variant/20 shadow-md text-left space-y-6">
        <div class="border-b border-outline-variant/15 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
                <h3 class="text-xl font-bold text-primary">List of @categoryName Projects</h3>
                <p class="text-xs text-on-surface-variant/80">Showing verified projects from the NDDC Project Management Information System</p>
            </div>
            @if (Model.TotalProjects > 0)
            {
                <span class="text-xs font-semibold text-on-surface-variant/80 bg-surface-container px-3 py-1.5 rounded-lg border border-outline-variant/20">
                    Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalProjects.ToString("N0") total)
                </span>
            }
        </div>

        <!-- Desktop Table View (Hidden on mobile) -->
        <div class="hidden md:block overflow-x-auto rounded-xl border border-outline-variant/20">
            <table class="w-full text-left text-sm min-w-[640px]">
                <thead class="bg-surface-container text-primary uppercase text-xs font-bold border-b border-outline-variant/20">
                    <tr>
                        <th scope="col" class="px-5 py-4 w-16">S/N</th>
                        <th scope="col" class="px-5 py-4">Project Title</th>
                        <th scope="col" class="px-5 py-4">Location / State</th>
                        <th scope="col" class="px-5 py-4">Status</th>
                        <th scope="col" class="px-5 py-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/15 text-on-surface">
                    @if (Model.Projects != null && Model.Projects.Any())
                    {
                        var index = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                        foreach (var item in Model.Projects)
                        {
                            var isCompleted = !string.IsNullOrEmpty(item.Status) && 
                                              (item.Status.Contains("Complete", StringComparison.OrdinalIgnoreCase) || 
                                               item.Status.Contains("Commission", StringComparison.OrdinalIgnoreCase));
                            <tr class="hover:bg-surface-container-low transition-colors">
                                <td class="px-5 py-4 font-bold text-primary/80">@index</td>
                                <td class="px-5 py-4 font-semibold text-primary">
                                    <a asp-page="ProjectDetails" asp-route-pid="@item.PID" class="hover:text-secondary transition-colors line-clamp-2">
                                        @item.ProjectName
                                    </a>
                                </td>
                                <td class="px-5 py-4 text-on-surface-variant whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[15px] text-secondary">location_on</span>
                                        @(string.IsNullOrEmpty(item.Location) ? item.StateName : $"{item.Location}, {item.StateName}")
                                    </span>
                                </td>
                                <td class="px-5 py-4 whitespace-nowrap">
                                    @if (isCompleted)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                            @(string.IsNullOrEmpty(item.Status) ? "Completed" : item.Status)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            @(string.IsNullOrEmpty(item.Status) ? "Ongoing" : item.Status)
                                        </span>
                                    }
                                </td>
                                <td class="px-5 py-4 text-right whitespace-nowrap">
                                    <a asp-page="ProjectDetails" asp-route-pid="@item.PID" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-4 py-2 rounded-full transition-all shadow-sm inline-flex items-center gap-1">
                                        <span>View</span>
                                        <span class="material-symbols-outlined text-[13px]">arrow_forward</span>
                                    </a>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-on-surface-variant">
                                <span class="material-symbols-outlined text-4xl text-on-surface-variant/40 mb-2 block">folder_off</span>
                                <p class="text-sm font-semibold text-primary">No projects found for this category</p>
                                <p class="text-xs text-on-surface-variant/70 mt-1">Please try checking other categories or visit the search directory.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Projects Card List (Shown on screens < 768px) -->
        <div class="block md:hidden space-y-3">
            @if (Model.Projects != null && Model.Projects.Any())
            {
                var mIndex = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                foreach (var item in Model.Projects)
                {
                    var isCompleted = !string.IsNullOrEmpty(item.Status) && 
                                      (item.Status.Contains("Complete", StringComparison.OrdinalIgnoreCase) || 
                                       item.Status.Contains("Commission", StringComparison.OrdinalIgnoreCase));
                    <div class="bg-surface-container-low/60 rounded-xl p-4 border border-outline-variant/20 space-y-2.5">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-mono font-bold text-primary/70">#@mIndex</span>
                            @if (isCompleted)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                    @(string.IsNullOrEmpty(item.Status) ? "Completed" : item.Status)
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                    @(string.IsNullOrEmpty(item.Status) ? "Ongoing" : item.Status)
                                </span>
                            }
                        </div>
                        <h4 class="text-sm font-bold text-primary leading-snug">
                            <a asp-page="ProjectDetails" asp-route-pid="@item.PID" class="hover:text-secondary transition-colors">
                                @item.ProjectName
                            </a>
                        </h4>
                        <div class="flex items-center justify-between gap-2 pt-2 border-t border-outline-variant/10 text-xs">
                            <span class="text-on-surface-variant flex items-center gap-1 truncate max-w-[65%]">
                                <span class="material-symbols-outlined text-[14px] text-secondary shrink-0">location_on</span>
                                <span class="truncate">@(string.IsNullOrEmpty(item.Location) ? item.StateName : $"{item.Location}, {item.StateName}")</span>
                            </span>
                            <a asp-page="ProjectDetails" asp-route-pid="@item.PID" class="bg-secondary text-white font-bold px-3 py-1.5 rounded-lg text-xs shrink-0 inline-flex items-center gap-1 shadow-sm">
                                <span>View</span>
                                <span class="material-symbols-outlined text-xs">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                    mIndex++;
                }
            }
            else
            {
                <div class="py-8 text-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-3xl text-on-surface-variant/40 mb-1 block">folder_off</span>
                    <p class="text-xs font-semibold text-primary">No projects found for this category</p>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-3">
                <div class="text-xs text-on-surface-variant text-center sm:text-left">
                    Showing page <span class="font-bold text-primary">@Model.CurrentPage</span> of <span class="font-bold text-primary">@Model.TotalPages</span>
                </div>

                <nav class="flex items-center justify-center gap-1.5 flex-wrap">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-page="Category" asp-route-pcid="@Model.PCID" asp-route-pageNumber="@(Model.CurrentPage - 1)" 
                           class="px-3 py-1.5 rounded-lg border border-outline-variant/30 text-xs font-bold text-primary hover:bg-surface-container transition-all flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">chevron_left</span> Prev
                        </a>
                    }

                    <div class="hidden sm:flex items-center gap-1">
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                            if (startPage > 1)
                            {
                                <a asp-page="Category" asp-route-pcid="@Model.PCID" asp-route-pageNumber="1" 
                                   class="w-8 h-8 rounded-lg border border-outline-variant/30 text-xs font-bold text-primary hover:bg-surface-container transition-all flex items-center justify-center">1</a>
                                if (startPage > 2)
                                {
                                    <span class="px-1 text-on-surface-variant/50">...</span>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                if (i == Model.CurrentPage)
                                {
                                    <span class="w-8 h-8 rounded-lg bg-secondary text-white text-xs font-bold flex items-center justify-center shadow-sm">@i</span>
                                }
                                else
                                {
                                    <a asp-page="Category" asp-route-pcid="@Model.PCID" asp-route-pageNumber="@i" 
                                       class="w-8 h-8 rounded-lg border border-outline-variant/30 text-xs font-bold text-primary hover:bg-surface-container transition-all flex items-center justify-center">@i</a>
                                }
                            }

                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <span class="px-1 text-on-surface-variant/50">...</span>
                                }
                                <a asp-page="Category" asp-route-pcid="@Model.PCID" asp-route-pageNumber="@Model.TotalPages" 
                                   class="w-8 h-8 rounded-lg border border-outline-variant/30 text-xs font-bold text-primary hover:bg-surface-container transition-all flex items-center justify-center">@Model.TotalPages</a>
                            }
                        }
                    </div>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-page="Category" asp-route-pcid="@Model.PCID" asp-route-pageNumber="@(Model.CurrentPage + 1)" 
                           class="px-3 py-1.5 rounded-lg border border-outline-variant/30 text-xs font-bold text-primary hover:bg-surface-container transition-all flex items-center gap-1">
                            Next <span class="material-symbols-outlined text-sm">chevron_right</span>
                        </a>
                    }
                </nav>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            var chartElement = document.querySelector("#chart");
            if (chartElement) {
                var options = {
                    series: [{
                        name: 'Executed Projects',
                        data: [
                            { x: '2018', y: [2800, 4500] },
                            { x: '2019', y: [3200, 4100] },
                            { x: '2020', y: [2950, 7800] },
                            { x: '2021', y: [3000, 4600] },
                            { x: '2022', y: [3500, 4100] },
                            { x: '2023', y: [4500, 6500] },
                            { x: '2024', y: [4100, 5600] }
                        ]
                    }],
                    chart: {
                        height: 300,
                        type: 'rangeBar',
                        zoom: { enabled: false },
                        toolbar: { show: false }
                    },
                    plotOptions: {
                        bar: {
                            isDumbbell: true,
                            columnWidth: 6,
                            dumbbellColors: [['#006d37', '#00322d']]
                        }
                    },
                    legend: { show: false },
                    grid: { borderColor: '#e2e8f0' }
                };

                var chart = new ApexCharts(chartElement, options);
                chart.render();
            }
        });
    </script>
}