@page
@model NDDC_Website_2024.Pages.Services.ProjectDatabase.CategoryModel
@{
    Layout = "_Layout";
}

<!-- Hero Banner -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
    <div class="max-w-container-max mx-auto text-left">
        <nav class="flex flex-wrap items-center gap-2 mb-4 md:mb-stack-gap text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
            <a class="hover:text-primary transition-colors" href="/">Home</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <a class="hover:text-primary transition-colors" href="/Services/ProjectDatabase/Index">Project Database</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-primary font-semibold">Category Overview</span>
        </nav>
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div>
                <h1 class="font-display-lg text-3xl sm:text-5xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight">
                    Roads & Bridges
                </h1>
                <div class="w-16 sm:w-24 h-1 sm:h-1.5 bg-secondary mt-3 rounded-full"></div>
            </div>
            <span class="bg-secondary/10 text-secondary font-extrabold text-sm sm:text-base px-5 py-2.5 rounded-full border border-secondary/20 shadow-sm">
                3,649 Executed Projects
            </span>
        </div>
    </div>
</section>

<!-- Chart Section -->
<section class="py-8 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto">
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-outline-variant/20 shadow-md text-left">
        <h3 class="text-lg font-bold text-primary mb-4">Yearly Project Execution Trend</h3>
        <div id="chart" class="w-full min-h-[320px]"></div>
    </div>
</section>

<!-- Projects Table Section -->
<section class="pb-16 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto">
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-outline-variant/20 shadow-md text-left space-y-6">
        <div class="border-b border-outline-variant/15 pb-4">
            <h3 class="text-xl font-bold text-primary">List of Category Projects</h3>
        </div>

        <div class="overflow-x-auto rounded-xl border border-outline-variant/20">
            <table class="w-full text-left text-sm">
                <thead class="bg-surface-container text-primary uppercase text-xs font-bold border-b border-outline-variant/20">
                    <tr>
                        <th scope="col" class="px-6 py-4">S/N</th>
                        <th scope="col" class="px-6 py-4">Project Title</th>
                        <th scope="col" class="px-6 py-4">State</th>
                        <th scope="col" class="px-6 py-4">Category</th>
                        <th scope="col" class="px-6 py-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/15 text-on-surface">
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="px-6 py-4 font-bold text-primary">1</td>
                        <td class="px-6 py-4 font-semibold text-primary">Construction of Dualized Ring Road Phase 2</td>
                        <td class="px-6 py-4 text-on-surface-variant">Rivers State</td>
                        <td class="px-6 py-4 text-on-surface-variant">Roads & Bridges</td>
                        <td class="px-6 py-4 text-right">
                            <a href="/Services/ProjectDatabase/ProjectDetails" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-4 py-2 rounded-full transition-all shadow-sm">View Details</a>
                        </td>
                    </tr>
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="px-6 py-4 font-bold text-primary">2</td>
                        <td class="px-6 py-4 font-semibold text-primary">Rehabilitation of Aba-Ikot Ekpene Highway Link</td>
                        <td class="px-6 py-4 text-on-surface-variant">Abia State</td>
                        <td class="px-6 py-4 text-on-surface-variant">Roads & Bridges</td>
                        <td class="px-6 py-4 text-right">
                            <a href="/Services/ProjectDatabase/ProjectDetails" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-4 py-2 rounded-full transition-all shadow-sm">View Details</a>
                        </td>
                    </tr>
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="px-6 py-4 font-bold text-primary">3</td>
                        <td class="px-6 py-4 font-semibold text-primary">Construction of Coastal Bridge at Nembe</td>
                        <td class="px-6 py-4 text-on-surface-variant">Bayelsa State</td>
                        <td class="px-6 py-4 text-on-surface-variant">Roads & Bridges</td>
                        <td class="px-6 py-4 text-right">
                            <a href="/Services/ProjectDatabase/ProjectDetails" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-4 py-2 rounded-full transition-all shadow-sm">View Details</a>
                        </td>
                    </tr>
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="px-6 py-4 font-bold text-primary">4</td>
                        <td class="px-6 py-4 font-semibold text-primary">Asphalt Overlay on Owerri Urban Access Road</td>
                        <td class="px-6 py-4 text-on-surface-variant">Imo State</td>
                        <td class="px-6 py-4 text-on-surface-variant">Roads & Bridges</td>
                        <td class="px-6 py-4 text-right">
                            <a href="/Services/ProjectDatabase/ProjectDetails" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-xs px-4 py-2 rounded-full transition-all shadow-sm">View Details</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            var options = {
                series: [{
                    name: 'Executed Projects',
                    data: [
                        { x: '2018', y: [2800, 4500] },
                        { x: '2019', y: [3200, 4100] },
                        { x: '2020', y: [2950, 7800] },
                        { x: '2021', y: [3000, 4600] },
                        { x: '2022', y: [3500, 4100] },
                        { x: '2023', y: [4500, 6500] },
                        { x: '2024', y: [4100, 5600] }
                    ]
                }],
                chart: {
                    height: 320,
                    type: 'rangeBar',
                    zoom: { enabled: false }
                },
                plotOptions: {
                    bar: {
                        isDumbbell: true,
                        columnWidth: 6,
                        dumbbellColors: [['#15803d', '#2563eb']]
                    }
                },
                legend: { show: false },
                grid: { borderColor: '#f1f5f9' }
            };

            var chart = new ApexCharts(document.querySelector("#chart"), options);
            chart.render();
        });
    </script>
}