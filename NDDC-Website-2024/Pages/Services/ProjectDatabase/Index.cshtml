@page
@model NDDC_Website_2024.Pages.Services.ProjectDatabase.IndexModel
@{
    Layout = "_Layout";
}

<!-- Hero / Breadcrumb & Search Section -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
    <div class="max-w-container-max mx-auto text-left space-y-6">
        <nav class="flex flex-wrap items-center gap-2 text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
            <a class="hover:text-primary transition-colors" href="/">Home</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-on-surface-variant">Services</span>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-primary font-semibold">Project Database</span>
        </nav>
        
        <div>
            <h1 class="font-display-lg text-3xl sm:text-5xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight">
                Discover NDDC Projects
            </h1>
            <p class="text-on-surface-variant text-sm sm:text-base mt-2 max-w-3xl">Search across thousands of infrastructure, social, and economic development projects executed across the 9 Niger Delta states.</p>
        </div>

        <!-- Search Bar Card -->
        <div class="bg-white rounded-2xl p-4 sm:p-6 border border-outline-variant/20 shadow-lg text-left">
            <form method="post" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
                <div>
                    <label for="projectNameInput" class="block text-xs font-bold text-primary uppercase tracking-wider mb-1.5">Project Name / Keyword</label>
                    <input type="text" id="projectNameInput" asp-for="@Model.Project.ProjectName" placeholder="Enter keyword or title..." class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/30 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all">
                </div>

                <div>
                    <label for="stateSelect" class="block text-xs font-bold text-primary uppercase tracking-wider mb-1.5">Select State</label>
                    <select id="stateSelect" asp-for="@Model.Project.SID" asp-items="@(new SelectList(Model.States, "SID", "StateName"))" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/30 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white">
                        <option value="0">All States</option>
                    </select>
                </div>

                <div>
                    <label for="categorySelect" class="block text-xs font-bold text-primary uppercase tracking-wider mb-1.5">Select Category</label>
                    <select id="categorySelect" asp-for="@Model.Project.PCID" asp-items="@(new SelectList(Model.ProjectCategories, "PCID", "CatName"))" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/30 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white">
                        <option value="0">All Categories</option>
                    </select>
                </div>

                <div>
                    <button type="submit" class="w-full bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-sm px-6 py-2.5 rounded-lg transition-all duration-300 shadow-md hover:shadow-lg inline-flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-sm">search</span> Search Database
                    </button>
                </div>
            </form>
        </div>

        <!-- High-Impact KPI Metrics Bar (Version 1 Reference) -->
        <div class="mt-6 sm:mt-8 bg-[#006d37] text-white rounded-2xl sm:rounded-3xl shadow-xl overflow-hidden border border-white/10">
            <div class="grid grid-cols-2 lg:grid-cols-4">
                <!-- KPI 1: Projects and Programs -->
                <div class="p-5 sm:p-7 md:p-8 flex flex-col justify-center text-left border-b lg:border-b-0 border-r border-white/20">
                    <span class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-none">
                        @((Model.Insights?.TotalProjects > 0 ? Model.Insights.TotalProjects : 21283).ToString("N0"))
                    </span>
                    <span class="text-white/90 text-xs sm:text-sm md:text-base font-medium mt-2 sm:mt-3 leading-snug">
                        Projects and Programs
                    </span>
                </div>

                <!-- KPI 2: Completed Projects -->
                <div class="p-5 sm:p-7 md:p-8 flex flex-col justify-center text-left border-b lg:border-b-0 lg:border-r border-white/20">
                    <span class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-none">
                        @((Model.Insights?.CompletedProjects > 0 ? Model.Insights.CompletedProjects : 184).ToString("N0"))
                    </span>
                    <span class="text-white/90 text-xs sm:text-sm md:text-base font-medium mt-2 sm:mt-3 leading-snug">
                        Completed Projects
                    </span>
                </div>

                <!-- KPI 3: Mandate States Covered -->
                <div class="p-5 sm:p-7 md:p-8 flex flex-col justify-center text-left border-r border-white/20">
                    <span class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-none">
                        @((Model.Insights?.StatesCovered > 0 ? Model.Insights.StatesCovered : 13).ToString("N0"))
                    </span>
                    <span class="text-white/90 text-xs sm:text-sm md:text-base font-medium mt-2 sm:mt-3 leading-snug">
                        Mandate States Covered
                    </span>
                </div>

                <!-- KPI 4: Development Sectors -->
                <div class="p-5 sm:p-7 md:p-8 flex flex-col justify-center text-left">
                    <span class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-none">
                        @((Model.Insights?.TotalCategories > 0 ? Model.Insights.TotalCategories : 18).ToString("N0"))
                    </span>
                    <span class="text-white/90 text-xs sm:text-sm md:text-base font-medium mt-2 sm:mt-3 leading-snug">
                        Development Sectors
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories & States Overview -->
<section class="py-12 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto space-y-12">
    <!-- Categories Grid -->
    <div>
        <div class="flex items-center justify-between mb-6 flex-wrap gap-2 text-left">
            <div>
                <h2 class="text-2xl font-bold text-primary mt-1">Browse Projects by Category</h2>
            </div>
      
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
            @if (Model.TopCategories != null && Model.TopCategories.Any())
            {
                foreach (var cat in Model.TopCategories)
                {
                    <a asp-page="Category" asp-route-pcid="@cat.PCID" class="group bg-white rounded-2xl p-5 sm:p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left flex flex-col justify-between">
                        <div class="space-y-3">
                            <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
                                <span class="material-symbols-outlined text-2xl">
                                    @(cat.CatName.ToLower().Contains("road") || cat.CatName.ToLower().Contains("bridge") ? "add_road" :
                                      cat.CatName.ToLower().Contains("water") ? "water_drop" :
                                      cat.CatName.ToLower().Contains("solar") || cat.CatName.ToLower().Contains("electric") ? "lightbulb" :
                                      cat.CatName.ToLower().Contains("canal") || cat.CatName.ToLower().Contains("desilt") ? "waves" : "account_tree")
                                </span>
                            </div>
                            <h3 class="text-base sm:text-lg font-bold text-primary group-hover:text-secondary transition-colors line-clamp-1">@cat.CatName</h3>
                            @if (cat.ProjCount > 0)
                            {
                                <p class="text-xl sm:text-2xl font-extrabold text-secondary">@cat.ProjCount.ToString("N0") <span class="text-xs font-normal text-on-surface-variant">Projects</span></p>
                            }
                        </div>
                        <span class="mt-4 text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                            View Projects <span class="material-symbols-outlined text-xs">arrow_forward</span>
                        </span>
                    </a>
                }
            }
            else
            {
                <a asp-page="Category" asp-route-pcid="1" class="group bg-white rounded-2xl p-5 sm:p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left flex flex-col justify-between">
                    <div class="space-y-3">
                        <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
                            <span class="material-symbols-outlined text-2xl">add_road</span>
                        </div>
                        <h3 class="text-base sm:text-lg font-bold text-primary group-hover:text-secondary transition-colors">Roads & Bridges</h3>
                        <p class="text-xl sm:text-2xl font-extrabold text-secondary">@Model.RoadsCount.ToString("N0") <span class="text-xs font-normal text-on-surface-variant">Projects</span></p>
                    </div>
                    <span class="mt-4 text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                        View Projects <span class="material-symbols-outlined text-xs">arrow_forward</span>
                    </span>
                </a>
            }
        </div>
    </div>

    <!-- Latest Projects Showcase -->
    @if (Model.LatestProjects != null && Model.LatestProjects.Any())
    {
        <div>
            <div class="flex items-center justify-between mb-6 flex-wrap gap-2 text-left">
                <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-primary mt-1">Latest Commissioned Projects</h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 text-left">
                @foreach (var item in Model.LatestProjects)
                {
                    <div class="bg-white rounded-2xl p-5 sm:p-6 border border-outline-variant/20 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-4">
                        <div class="space-y-2.5">
                            <div class="flex items-center justify-between gap-2 flex-wrap">
                                <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-primary/5 text-primary border border-primary/10">
                                    @(item.CatName ?? "Project")
                                </span>
                                @if (item.PID > 0)
                                {
                                    <span class="text-[11px] font-mono text-on-surface-variant/70">#@item.PID</span>
                                }
                            </div>
                            <h3 class="text-sm sm:text-base font-bold text-primary hover:text-secondary transition-colors line-clamp-2">
                                <a asp-page="ProjectDetails" asp-route-pid="@item.PID">@item.ProjectName</a>
                            </h3>
                            @if (!string.IsNullOrEmpty(item.Location))
                            {
                                <p class="text-xs text-on-surface-variant flex items-start gap-1.5 break-words">
                                    <span class="material-symbols-outlined text-sm text-secondary shrink-0 mt-0.5">location_on</span>
                                    <span>@item.Location</span>
                                </p>
                            }
                        </div>
                        <div class="pt-3 border-t border-outline-variant/10 flex items-center justify-between">
                            <a asp-page="ProjectDetails" asp-route-pid="@item.PID" class="text-xs font-bold text-secondary hover:text-primary transition-colors inline-flex items-center gap-1">
                                View Details <span class="material-symbols-outlined text-xs">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- State Offices / Region Distribution Grid -->
    <div>
        <div class="text-left mb-6">
            <h2 class="text-xl sm:text-2xl font-bold text-primary mt-1">Regional State Distribution</h2>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4 text-left">
            @if (Model.States != null && Model.States.Any())
            {
                foreach (var state in Model.States)
                {
                    <a asp-page="SearchResults" asp-route-sid="@state.SID" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                        <h4 class="font-bold text-primary text-sm sm:text-base truncate">@state.StateName</h4>
                        <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">
                            Explore <span class="material-symbols-outlined text-xs">chevron_right</span>
                        </span>
                    </a>
                }
            }
            else
            {
                <a asp-page="SearchResults" asp-route-sid="1" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                    <h4 class="font-bold text-primary text-sm sm:text-base truncate">Abia State</h4>
                    <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">Explore <span class="material-symbols-outlined text-xs">chevron_right</span></span>
                </a>
                <a asp-page="SearchResults" asp-route-sid="2" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                    <h4 class="font-bold text-primary text-sm sm:text-base truncate">Akwa Ibom</h4>
                    <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">Explore <span class="material-symbols-outlined text-xs">chevron_right</span></span>
                </a>
                <a asp-page="SearchResults" asp-route-sid="3" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                    <h4 class="font-bold text-primary text-sm sm:text-base truncate">Bayelsa State</h4>
                    <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">Explore <span class="material-symbols-outlined text-xs">chevron_right</span></span>
                </a>
                <a asp-page="SearchResults" asp-route-sid="4" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                    <h4 class="font-bold text-primary text-sm sm:text-base truncate">Cross River</h4>
                    <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">Explore <span class="material-symbols-outlined text-xs">chevron_right</span></span>
                </a>
                <a asp-page="SearchResults" asp-route-sid="5" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                    <h4 class="font-bold text-primary text-sm sm:text-base truncate">Delta State</h4>
                    <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">Explore <span class="material-symbols-outlined text-xs">chevron_right</span></span>
                </a>
                <a asp-page="SearchResults" asp-route-sid="6" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                    <h4 class="font-bold text-primary text-sm sm:text-base truncate">Edo State</h4>
                    <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">Explore <span class="material-symbols-outlined text-xs">chevron_right</span></span>
                </a>
                <a asp-page="SearchResults" asp-route-sid="7" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                    <h4 class="font-bold text-primary text-sm sm:text-base truncate">Imo State</h4>
                    <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">Explore <span class="material-symbols-outlined text-xs">chevron_right</span></span>
                </a>
                <a asp-page="SearchResults" asp-route-sid="8" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                    <h4 class="font-bold text-primary text-sm sm:text-base truncate">Ondo State</h4>
                    <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">Explore <span class="material-symbols-outlined text-xs">chevron_right</span></span>
                </a>
                <a asp-page="SearchResults" asp-route-sid="9" class="bg-white hover:bg-surface-container rounded-xl p-3.5 sm:p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all block">
                    <h4 class="font-bold text-primary text-sm sm:text-base truncate">Rivers State</h4>
                    <span class="text-xs text-secondary font-semibold mt-1 inline-flex items-center gap-0.5 sm:gap-1">Explore <span class="material-symbols-outlined text-xs">chevron_right</span></span>
                </a>
            }
        </div>
    </div>
</section>
