@page
@model NDDC_Website_2024.Pages.Services.ProjectDatabase.IndexModel
@{
    Layout = "_Layout";
}

<!-- Hero / Breadcrumb & Search Section -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
    <div class="max-w-container-max mx-auto text-left space-y-6">
        <nav class="flex flex-wrap items-center gap-2 text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
            <a class="hover:text-primary transition-colors" href="/">Home</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-on-surface-variant">Services</span>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-primary font-semibold">Project Database</span>
        </nav>
        
        <div>
            <h1 class="font-display-lg text-3xl sm:text-5xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight">
                Discover NDDC Projects
            </h1>
            <p class="text-on-surface-variant text-sm sm:text-base mt-2 max-w-3xl">Search across thousands of infrastructure, social, and economic development projects executed across the 9 Niger Delta states.</p>
        </div>

        <!-- Search Bar Card -->
        <div class="bg-white rounded-2xl p-4 sm:p-6 border border-outline-variant/20 shadow-lg text-left">
            <form method="post" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-center">
                <div>
                    <label for="projectNameInput" class="block text-xs font-bold text-primary uppercase tracking-wider mb-1.5">Project Name / Keyword</label>
                    <input type="text" id="projectNameInput" asp-for="@Model.Project.ProjectName" placeholder="Enter keyword or title..." class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/30 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all">
                </div>

                <div>
                    <label for="stateSelect" class="block text-xs font-bold text-primary uppercase tracking-wider mb-1.5">Select State</label>
                    <select id="stateSelect" asp-for="@Model.Project.SID" asp-items="@(new SelectList(Model.States, "SID", "StateName"))" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/30 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white">
                        <option value="0">All States</option>
                    </select>
                </div>

                <div>
                    <label for="categorySelect" class="block text-xs font-bold text-primary uppercase tracking-wider mb-1.5">Select Category</label>
                    <select id="categorySelect" asp-for="@Model.Project.PCID" asp-items="@(new SelectList(Model.ProjectCategories, "PCID", "CatName"))" class="w-full px-4 py-2.5 rounded-lg border border-outline-variant/30 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white">
                        <option value="0">All Categories</option>
                    </select>
                </div>

                <div class="pt-2 sm:pt-6">
                    <button type="submit" class="w-full bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-sm px-6 py-3 rounded-xl transition-all duration-300 shadow-md hover:shadow-lg inline-flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-sm">search</span> Search Database
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Categories & States Overview -->
<section class="py-12 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto space-y-12">
    <!-- Categories Grid -->
    <div>
        <div class="text-left mb-6">
            <span class="bg-secondary/10 text-secondary text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block">Sectors</span>
            <h2 class="text-2xl font-bold text-primary mt-1">Browse Projects by Category</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Roads/Bridges -->
            <a href="/Services/ProjectDatabase/Category" class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left flex flex-col justify-between">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
                        <span class="material-symbols-outlined text-2xl">add_road</span>
                    </div>
                    <h3 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors">Roads & Bridges</h3>
                    <p class="text-2xl font-extrabold text-secondary">@Model.RoadsCount <span class="text-xs font-normal text-on-surface-variant">Projects</span></p>
                </div>
                <span class="mt-4 text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    View Projects <span class="material-symbols-outlined text-xs">arrow_forward</span>
                </span>
            </a>

            <!-- Desilting -->
            <a href="/Services/ProjectDatabase/Category" class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left flex flex-col justify-between">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
                        <span class="material-symbols-outlined text-2xl">waves</span>
                    </div>
                    <h3 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors">Canal Desilting</h3>
                    <p class="text-2xl font-extrabold text-secondary">2,773 <span class="text-xs font-normal text-on-surface-variant">Projects</span></p>
                </div>
                <span class="mt-4 text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    View Insights <span class="material-symbols-outlined text-xs">arrow_forward</span>
                </span>
            </a>

            <!-- Water Supply -->
            <a href="/Services/ProjectDatabase/Category" class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left flex flex-col justify-between">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
                        <span class="material-symbols-outlined text-2xl">water_drop</span>
                    </div>
                    <h3 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors">Water Supply</h3>
                    <p class="text-2xl font-extrabold text-secondary">1,845 <span class="text-xs font-normal text-on-surface-variant">Projects</span></p>
                </div>
                <span class="mt-4 text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    View Insights <span class="material-symbols-outlined text-xs">arrow_forward</span>
                </span>
            </a>

            <!-- Electricity & Solar -->
            <a href="/Services/ProjectDatabase/Category" class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-left flex flex-col justify-between">
                <div class="space-y-3">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
                        <span class="material-symbols-outlined text-2xl">lightbulb</span>
                    </div>
                    <h3 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors">Electrification & Solar</h3>
                    <p class="text-2xl font-extrabold text-secondary">3,120 <span class="text-xs font-normal text-on-surface-variant">Projects</span></p>
                </div>
                <span class="mt-4 text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    View Insights <span class="material-symbols-outlined text-xs">arrow_forward</span>
                </span>
            </a>
        </div>
    </div>

    <!-- State Offices / Region Distribution Grid -->
    <div>
        <div class="text-left mb-6">
            <span class="bg-secondary/10 text-secondary text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block">Member States</span>
            <h2 class="text-2xl font-bold text-primary mt-1">Regional State Distribution</h2>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 text-left">
            <a href="/Services/ProjectDatabase/StateDetails" class="bg-white hover:bg-surface-container rounded-xl p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all">
                <h4 class="font-bold text-primary text-base">Abia State</h4>
                <p class="text-xs text-secondary font-semibold mt-1">1,240 Projects</p>
            </a>
            <a href="/Services/ProjectDatabase/StateDetails" class="bg-white hover:bg-surface-container rounded-xl p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all">
                <h4 class="font-bold text-primary text-base">Akwa Ibom</h4>
                <p class="text-xs text-secondary font-semibold mt-1">3,150 Projects</p>
            </a>
            <a href="/Services/ProjectDatabase/StateDetails" class="bg-white hover:bg-surface-container rounded-xl p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all">
                <h4 class="font-bold text-primary text-base">Bayelsa State</h4>
                <p class="text-xs text-secondary font-semibold mt-1">4,344 Projects</p>
            </a>
            <a href="/Services/ProjectDatabase/StateDetails" class="bg-white hover:bg-surface-container rounded-xl p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all">
                <h4 class="font-bold text-primary text-base">Cross River</h4>
                <p class="text-xs text-secondary font-semibold mt-1">2,080 Projects</p>
            </a>
            <a href="/Services/ProjectDatabase/StateDetails" class="bg-white hover:bg-surface-container rounded-xl p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all">
                <h4 class="font-bold text-primary text-base">Delta State</h4>
                <p class="text-xs text-secondary font-semibold mt-1">4,890 Projects</p>
            </a>
            <a href="/Services/ProjectDatabase/StateDetails" class="bg-white hover:bg-surface-container rounded-xl p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all">
                <h4 class="font-bold text-primary text-base">Edo State</h4>
                <p class="text-xs text-secondary font-semibold mt-1">1,960 Projects</p>
            </a>
            <a href="/Services/ProjectDatabase/StateDetails" class="bg-white hover:bg-surface-container rounded-xl p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all">
                <h4 class="font-bold text-primary text-base">Imo State</h4>
                <p class="text-xs text-secondary font-semibold mt-1">1,780 Projects</p>
            </a>
            <a href="/Services/ProjectDatabase/StateDetails" class="bg-white hover:bg-surface-container rounded-xl p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all">
                <h4 class="font-bold text-primary text-base">Ondo State</h4>
                <p class="text-xs text-secondary font-semibold mt-1">1,450 Projects</p>
            </a>
            <a href="/Services/ProjectDatabase/StateDetails" class="bg-white hover:bg-surface-container rounded-xl p-4 border border-outline-variant/20 shadow-sm hover:border-secondary transition-all">
                <h4 class="font-bold text-primary text-base">Rivers State</h4>
                <p class="text-xs text-secondary font-semibold mt-1">5,120 Projects</p>
            </a>
        </div>
    </div>
</section>
