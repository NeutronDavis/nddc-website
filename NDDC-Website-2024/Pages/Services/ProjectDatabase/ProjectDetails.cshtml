@page "{pid:int?}"
@model NDDC_Website_2024.Pages.Services.ProjectDatabase.ProjectDetailsModel
@{
    Layout = "_Layout";
    var proj = Model.ProjectDetails;
    var isCompleted = !string.IsNullOrEmpty(proj?.Status) && 
                      (proj.Status.Contains("Complete", StringComparison.OrdinalIgnoreCase) || 
                       proj.Status.Contains("Commission", StringComparison.OrdinalIgnoreCase));
}

<!-- Hero Banner -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
    <div class="max-w-container-max mx-auto text-left">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 mb-4 md:mb-stack-gap">
            <nav class="flex flex-wrap items-center gap-1.5 sm:gap-2 text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
                <a class="hover:text-primary transition-colors" href="/">Home</a>
                <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
                <a class="hover:text-primary transition-colors" href="/Services/ProjectDatabase/Index">Project Database</a>
                <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
                <span class="text-primary font-semibold">Project #@proj?.PID</span>
            </nav>
            <a href="/Services/ProjectDatabase/Index" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-secondary bg-white px-3.5 py-1.5 rounded-full border border-outline-variant/30 shadow-sm transition-all self-start sm:self-auto shrink-0">
                <span class="material-symbols-outlined text-sm">arrow_back</span> Back to Database
            </a>
        </div>

        <div class="flex flex-wrap items-center gap-2 mb-3">
            @if (!string.IsNullOrEmpty(proj?.CatName))
            {
                <span class="bg-secondary/10 text-secondary text-xs font-bold px-3 py-1 rounded-full border border-secondary/20">
                    @proj.CatName
                </span>
            }
            @if (!string.IsNullOrEmpty(proj?.Status))
            {
                if (isCompleted)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                        @proj.Status
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        @proj.Status
                    </span>
                }
            }
            @if (proj?.PID > 0)
            {
                <span class="bg-surface-container text-on-surface-variant text-xs font-bold px-3 py-1 rounded-full border border-outline-variant/20">
                    PID: #@proj.PID
                </span>
            }
        </div>

        <h1 class="font-display-lg text-2xl sm:text-4xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight break-words">
            @(proj?.ProjectName ?? "Project Details")
        </h1>
        <div class="w-16 sm:w-24 h-1 sm:h-1.5 bg-secondary mt-3 sm:mt-6 rounded-full"></div>
    </div>
</section>

<!-- Details & Gallery Section -->
<section class="py-8 sm:py-12 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto space-y-6 sm:space-y-8">
    <!-- Structured Metadata Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <!-- Location Card -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-outline-variant/20 shadow-sm text-left flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-on-surface-variant/70 mb-2">
                    <span class="material-symbols-outlined text-base text-secondary">location_on</span>
                    State / Location
                </div>
                <p class="font-bold text-primary text-sm sm:text-base break-words">
                    @(string.IsNullOrEmpty(proj?.Location) ? (proj?.StateName ?? "N/A") : $"{proj.Location}, {proj.StateName}")
                </p>
            </div>
            <span class="text-[11px] text-on-surface-variant/60 mt-3 block">Jurisdiction: Niger Delta</span>
        </div>

        <!-- Commencement Date Card -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-outline-variant/20 shadow-sm text-left flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-on-surface-variant/70 mb-2">
                    <span class="material-symbols-outlined text-base text-secondary">calendar_today</span>
                    Commencement Date
                </div>
                <p class="font-bold text-primary text-sm sm:text-base">
                    @(proj != null && proj.CommencementDate != default 
                        ? proj.CommencementDate.ToString("MMMM dd, yyyy") 
                        : "Date Record Pending")
                </p>
            </div>
            <span class="text-[11px] text-on-surface-variant/60 mt-3 block">Official award timeline</span>
        </div>

        <!-- Contractor Card -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-outline-variant/20 shadow-sm text-left flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-on-surface-variant/70 mb-2">
                    <span class="material-symbols-outlined text-base text-secondary">engineering</span>
                    Contractor
                </div>
                <p class="font-bold text-primary text-sm sm:text-base line-clamp-2 break-words">
                    @(string.IsNullOrEmpty(proj?.Contractor) ? "N/A" : proj.Contractor)
                </p>
            </div>
            <span class="text-[11px] text-on-surface-variant/60 mt-3 block">Executing Partner</span>
        </div>

        <!-- Category Card -->
        <div class="bg-white rounded-2xl p-4 sm:p-5 border border-outline-variant/20 shadow-sm text-left flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-on-surface-variant/70 mb-2">
                    <span class="material-symbols-outlined text-base text-secondary">category</span>
                    Category
                </div>
                <p class="font-bold text-primary text-sm sm:text-base truncate">
                    @(string.IsNullOrEmpty(proj?.CatName) ? "General Infrastructure" : proj.CatName)
                </p>
            </div>
            @if (proj?.PCID > 0)
            {
                <a asp-page="Category" asp-route-pcid="@proj.PCID" class="text-xs font-bold text-secondary hover:underline mt-3 inline-flex items-center gap-1">
                    Explore Category <span class="material-symbols-outlined text-xs">arrow_forward</span>
                </a>
            }
        </div>
    </div>

    <!-- Gallery Section -->
    <div class="bg-white rounded-2xl p-4 sm:p-6 md:p-8 border border-outline-variant/20 shadow-md text-left space-y-4 sm:space-y-6">
        <div class="border-b border-outline-variant/15 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
                <h2 class="text-lg sm:text-2xl font-bold text-primary flex items-center gap-2">
                    <span class="material-symbols-outlined text-secondary">photo_camera</span> Project Media & Verification Photos
                </h2>
                <p class="text-xs text-on-surface-variant/80 mt-1">Field inspection photos documenting milestone delivery and site progress. Click any photo to preview.</p>
            </div>
            @if (Model.ProjectPictures != null && Model.ProjectPictures.Any())
            {
                <span class="bg-surface-container text-primary font-bold text-xs px-3 py-1.5 rounded-full border border-outline-variant/20 self-start sm:self-auto">
                    @Model.ProjectPictures.Count Photo@(Model.ProjectPictures.Count > 1 ? "s" : "") • Click to Preview
                </span>
            }
        </div>

        <div id="gallery" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
            @if (Model.ProjectPictures != null && Model.ProjectPictures.Any())
            {
                for (int i = 0; i < Model.ProjectPictures.Count; i++)
                {
                    var item = Model.ProjectPictures[i];
                    var imgUrl = Model.GetImageUrl(item.ImageUrl, item.ImageId);
                    <a class="project-gallery-item group relative block rounded-xl overflow-hidden shadow-sm hover:shadow-xl border border-outline-variant/20 transition-all duration-300 aspect-video bg-surface-container cursor-pointer"
                       href="@imgUrl"
                       data-src="@imgUrl"
                       data-index="@i"
                       data-title="@(proj?.ProjectName ?? "Project Photo") - Photo @(i + 1)"
                       onclick="openImagePreview(@i); return false;">
                        <img src="@imgUrl" 
                             alt="@(proj?.ProjectName ?? "Project Photo")" 
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                             loading="lazy"
                             onerror="this.onerror=null; this.src='/assets/image/department/plan-1.png';" />
                        <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center text-white backdrop-blur-[2px] p-2 text-center">
                            <span class="material-symbols-outlined text-3xl mb-1 drop-shadow">zoom_in</span>
                            <span class="text-[11px] sm:text-xs font-bold uppercase tracking-wider bg-black/50 px-2.5 py-1 rounded-full border border-white/20">Click to Preview</span>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="col-span-full py-12 text-center text-on-surface-variant">
                    <span class="material-symbols-outlined text-5xl text-on-surface-variant/40 mb-2 block">image_not_supported</span>
                    <p class="text-sm font-semibold text-primary">No site photos are currently available for this project</p>
                    <p class="text-xs text-on-surface-variant/70 mt-1">Field monitoring records for this project are currently being updated.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Fullscreen Interactive Image Preview Modal -->
<div id="imagePreviewModal" class="fixed inset-0 z-[99999] bg-black/95 backdrop-blur-md hidden flex-col justify-between select-none opacity-0 transition-opacity duration-300" role="dialog" aria-modal="true" aria-label="Image Preview">
    <!-- Top Action Bar -->
    <div class="px-4 sm:px-6 py-3.5 bg-black/50 border-b border-white/10 flex items-center justify-between z-10">
        <div class="flex items-center gap-3 text-white truncate max-w-[55%] sm:max-w-[70%]">
            <span class="material-symbols-outlined text-secondary text-2xl shrink-0">photo_library</span>
            <div class="truncate">
                <h4 id="previewModalTitle" class="text-xs sm:text-sm md:text-base font-bold text-white truncate leading-tight">@(proj?.ProjectName ?? "Project Photo")</h4>
                <p id="previewModalCounter" class="text-[11px] sm:text-xs text-white/60">Photo 1 of 1</p>
            </div>
        </div>

        <div class="flex items-center gap-1 sm:gap-2">
            <!-- Zoom Controls -->
            <button type="button" id="previewZoomOut" class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition" title="Zoom Out (-)">
                <span class="material-symbols-outlined text-base sm:text-lg">zoom_out</span>
            </button>
            <span id="previewZoomLevel" class="text-xs font-mono font-bold text-white/80 w-10 sm:w-12 text-center hidden sm:inline-block">100%</span>
            <button type="button" id="previewZoomIn" class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition" title="Zoom In (+)">
                <span class="material-symbols-outlined text-base sm:text-lg">zoom_in</span>
            </button>
            <button type="button" id="previewRotate" class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-white/10 hover:bg-white/20 text-white hidden sm:flex items-center justify-center transition" title="Rotate 90°">
                <span class="material-symbols-outlined text-base sm:text-lg">rotate_right</span>
            </button>
            <button type="button" id="previewResetZoom" class="px-2.5 h-8 sm:h-9 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-semibold text-white hidden sm:flex items-center justify-center transition" title="Reset Zoom">
                Reset
            </button>
            <a id="previewOpenTab" href="#" target="_blank" class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition" title="Open Original in New Tab">
                <span class="material-symbols-outlined text-base sm:text-lg">open_in_new</span>
            </a>
            <!-- Close Button -->
            <button type="button" id="previewCloseBtn" class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-red-600/80 hover:bg-red-600 text-white flex items-center justify-center transition ml-1" title="Close Preview (Esc)">
                <span class="material-symbols-outlined text-lg sm:text-xl">close</span>
            </button>
        </div>
    </div>

    <!-- Center Stage (Image + Prev / Next Nav) -->
    <div class="relative flex-1 flex items-center justify-center overflow-hidden p-2 sm:p-6" id="previewStageContainer">
        <!-- Previous Button -->
        <button type="button" id="previewPrevBtn" class="absolute left-2 sm:left-6 z-20 w-10 h-10 sm:w-14 sm:h-14 rounded-full bg-black/60 hover:bg-secondary text-white flex items-center justify-center shadow-2xl transition border border-white/15 hover:scale-105" title="Previous Photo (Left Arrow)">
            <span class="material-symbols-outlined text-2xl sm:text-3xl">chevron_left</span>
        </button>

        <!-- Image Wrapper -->
        <div id="previewImageWrapper" class="w-full h-full flex items-center justify-center transition-transform duration-100 ease-out cursor-grab">
            <img id="previewModalImg" src="" alt="Project Photo Preview" class="max-h-[70vh] sm:max-h-[76vh] max-w-[92vw] sm:max-w-[85vw] object-contain rounded-lg shadow-2xl transition-transform duration-200 pointer-events-none select-none" />
        </div>

        <!-- Next Button -->
        <button type="button" id="previewNextBtn" class="absolute right-2 sm:right-6 z-20 w-10 h-10 sm:w-14 sm:h-14 rounded-full bg-black/60 hover:bg-secondary text-white flex items-center justify-center shadow-2xl transition border border-white/15 hover:scale-105" title="Next Photo (Right Arrow)">
            <span class="material-symbols-outlined text-2xl sm:text-3xl">chevron_right</span>
        </button>
    </div>

    <!-- Bottom Thumbnail Strip & Shortcuts Bar -->
    <div class="px-4 sm:px-6 py-2.5 sm:py-3 bg-black/60 border-t border-white/10 flex flex-col items-center gap-2 z-10">
        <!-- Thumbnails row -->
        <div id="previewThumbnailStrip" class="flex items-center gap-2 overflow-x-auto max-w-full pb-1 no-scrollbar justify-center">
            <!-- Dynamically generated via JS -->
        </div>
        <div class="text-[11px] text-white/50 text-center flex items-center gap-2 sm:gap-3 flex-wrap justify-center">
            <span>Scroll wheel or double click to zoom</span>
            <span class="hidden sm:inline">•</span>
            <span class="hidden sm:inline">Press <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-white/80 font-mono text-[10px]">Esc</kbd> to close</span>
            <span class="hidden sm:inline">•</span>
            <span class="hidden sm:inline">Use <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-white/80 font-mono text-[10px]">←</kbd> <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-white/80 font-mono text-[10px]">→</kbd> to browse</span>
        </div>
    </div>
</div>

@section Scripts {
    <!-- LightGallery stylesheet & scripts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/css/lightgallery-bundle.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/lightgallery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/plugins/zoom/lg-zoom.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.7.2/plugins/thumbnail/lg-thumbnail.min.js"></script>

    <script>
        // High-Performance Interactive Image Preview Controller
        let galleryImages = [];
        let currentIndex = 0;
        let currentScale = 1;
        let currentRotation = 0;
        let isDragging = false;
        let startX = 0, startY = 0;
        let translateX = 0, translateY = 0;

        document.addEventListener('DOMContentLoaded', function() {
            // Gather all gallery items
            const items = document.querySelectorAll('.project-gallery-item');
            items.forEach((item, idx) => {
                galleryImages.push({
                    src: item.getAttribute('data-src') || item.getAttribute('href'),
                    title: item.getAttribute('data-title') || ('Photo ' + (idx + 1))
                });
            });

            // Initialize LightGallery if available
            const galleryElem = document.getElementById('gallery');
            if (galleryElem && window.lightGallery && galleryImages.length > 0) {
                try {
                    lightGallery(galleryElem, {
                        selector: '.project-gallery-item',
                        controls: true,
                        download: false,
                        thumbnail: true,
                        zoomFromOrigin: true,
                        plugins: [lgThumbnail, lgZoom]
                    });
                } catch (e) {
                    console.warn('LightGallery initialization fallback to native modal:', e);
                }
            }

            // Bind Modal UI controls
            const modal = document.getElementById('imagePreviewModal');
            const closeBtn = document.getElementById('previewCloseBtn');
            const prevBtn = document.getElementById('previewPrevBtn');
            const nextBtn = document.getElementById('previewNextBtn');
            const zoomInBtn = document.getElementById('previewZoomIn');
            const zoomOutBtn = document.getElementById('previewZoomOut');
            const resetZoomBtn = document.getElementById('previewResetZoom');
            const rotateBtn = document.getElementById('previewRotate');
            const imgWrapper = document.getElementById('previewImageWrapper');
            const stageContainer = document.getElementById('previewStageContainer');

            if (closeBtn) closeBtn.addEventListener('click', closeImagePreview);
            if (prevBtn) prevBtn.addEventListener('click', () => navigatePreview(-1));
            if (nextBtn) nextBtn.addEventListener('click', () => navigatePreview(1));

            if (zoomInBtn) zoomInBtn.addEventListener('click', () => adjustZoom(0.25));
            if (zoomOutBtn) zoomOutBtn.addEventListener('click', () => adjustZoom(-0.25));
            if (resetZoomBtn) resetZoomBtn.addEventListener('click', resetTransform);
            if (rotateBtn) rotateBtn.addEventListener('click', rotateImage);

            // Double click to toggle zoom
            if (imgWrapper) {
                imgWrapper.addEventListener('dblclick', function(e) {
                    if (currentScale > 1) {
                        resetTransform();
                    } else {
                        currentScale = 2;
                        updateTransform();
                    }
                });

                // Mouse wheel zoom
                imgWrapper.addEventListener('wheel', function(e) {
                    e.preventDefault();
                    if (e.deltaY < 0) {
                        adjustZoom(0.15);
                    } else {
                        adjustZoom(-0.15);
                    }
                }, { passive: false });

                // Pan/Drag support when zoomed
                imgWrapper.addEventListener('mousedown', function(e) {
                    if (currentScale <= 1) return;
                    isDragging = true;
                    startX = e.clientX - translateX;
                    startY = e.clientY - translateY;
                    imgWrapper.classList.remove('cursor-grab');
                    imgWrapper.classList.add('cursor-grabbing');
                });

                window.addEventListener('mousemove', function(e) {
                    if (!isDragging) return;
                    translateX = e.clientX - startX;
                    translateY = e.clientY - startY;
                    updateTransform();
                });

                window.addEventListener('mouseup', function() {
                    if (!isDragging) return;
                    isDragging = false;
                    imgWrapper.classList.remove('cursor-grabbing');
                    imgWrapper.classList.add('cursor-grab');
                });
            }

            // Keyboard navigation
            window.addEventListener('keydown', function(e) {
                const modal = document.getElementById('imagePreviewModal');
                if (modal && !modal.classList.contains('hidden')) {
                    if (e.key === 'Escape') closeImagePreview();
                    else if (e.key === 'ArrowLeft') navigatePreview(-1);
                    else if (e.key === 'ArrowRight') navigatePreview(1);
                    else if (e.key === '+' || e.key === '=') adjustZoom(0.25);
                    else if (e.key === '-') adjustZoom(-0.25);
                    else if (e.key === '0') resetTransform();
                }
            });

            // Close when clicking empty backdrop stage
            if (stageContainer) {
                stageContainer.addEventListener('click', function(e) {
                    if (e.target === stageContainer || e.target === imgWrapper) {
                        closeImagePreview();
                    }
                });
            }

            // Mobile touch swipe
            let touchStartX = 0;
            let touchEndX = 0;
            if (stageContainer) {
                stageContainer.addEventListener('touchstart', function(e) {
                    touchStartX = e.changedTouches[0].screenX;
                }, { passive: true });

                stageContainer.addEventListener('touchend', function(e) {
                    touchEndX = e.changedTouches[0].screenX;
                    handleSwipe();
                }, { passive: true });
            }

            function handleSwipe() {
                if (currentScale > 1) return; // Do not swipe if zoomed in
                const diff = touchEndX - touchStartX;
                if (Math.abs(diff) > 50) {
                    if (diff > 0) navigatePreview(-1);
                    else navigatePreview(1);
                }
            }
        });

        function openImagePreview(index) {
            if (!galleryImages || galleryImages.length === 0) return;
            currentIndex = (index >= 0 && index < galleryImages.length) ? index : 0;
            
            const modal = document.getElementById('imagePreviewModal');
            if (!modal) return;

            resetTransform();
            updatePreviewContent();
            renderThumbnailStrip();

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
            }, 10);

            document.body.style.overflow = 'hidden';
        }

        function closeImagePreview() {
            const modal = document.getElementById('imagePreviewModal');
            if (!modal) return;

            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                document.body.style.overflow = '';
            }, 250);
        }

        function navigatePreview(direction) {
            if (!galleryImages || galleryImages.length <= 1) return;
            currentIndex = (currentIndex + direction + galleryImages.length) % galleryImages.length;
            resetTransform();
            updatePreviewContent();
            highlightActiveThumbnail();
        }

        function updatePreviewContent() {
            const current = galleryImages[currentIndex];
            const modalImg = document.getElementById('previewModalImg');
            const counter = document.getElementById('previewModalCounter');
            const openTab = document.getElementById('previewOpenTab');
            const titleElem = document.getElementById('previewModalTitle');

            if (modalImg && current) {
                modalImg.src = current.src;
                modalImg.alt = current.title;
            }
            if (counter) {
                counter.textContent = `Photo ${currentIndex + 1} of ${galleryImages.length}`;
            }
            if (openTab && current) {
                openTab.href = current.src;
            }
            if (titleElem && current) {
                titleElem.textContent = current.title;
            }

            // Hide navigation arrows if only 1 image
            const prevBtn = document.getElementById('previewPrevBtn');
            const nextBtn = document.getElementById('previewNextBtn');
            if (galleryImages.length <= 1) {
                if (prevBtn) prevBtn.style.display = 'none';
                if (nextBtn) nextBtn.style.display = 'none';
            } else {
                if (prevBtn) prevBtn.style.display = 'flex';
                if (nextBtn) nextBtn.style.display = 'flex';
            }
        }

        function renderThumbnailStrip() {
            const strip = document.getElementById('previewThumbnailStrip');
            if (!strip) return;
            if (galleryImages.length <= 1) {
                strip.style.display = 'none';
                return;
            }
            strip.style.display = 'flex';
            strip.innerHTML = '';

            galleryImages.forEach((img, idx) => {
                const thumb = document.createElement('button');
                thumb.type = 'button';
                thumb.className = `w-14 h-10 sm:w-16 sm:h-12 rounded-lg overflow-hidden border-2 transition-all shrink-0 ${idx === currentIndex ? 'border-secondary scale-105 shadow-md' : 'border-transparent opacity-60 hover:opacity-100'}`;
                thumb.setAttribute('data-thumb-idx', idx);
                thumb.onclick = () => {
                    currentIndex = idx;
                    resetTransform();
                    updatePreviewContent();
                    highlightActiveThumbnail();
                };

                const imgElem = document.createElement('img');
                imgElem.src = img.src;
                imgElem.alt = img.title;
                imgElem.className = 'w-full h-full object-cover';
                thumb.appendChild(imgElem);
                strip.appendChild(thumb);
            });
        }

        function highlightActiveThumbnail() {
            const thumbs = document.querySelectorAll('#previewThumbnailStrip button');
            thumbs.forEach((thumb, idx) => {
                if (idx === currentIndex) {
                    thumb.classList.add('border-secondary', 'scale-105', 'shadow-md');
                    thumb.classList.remove('border-transparent', 'opacity-60');
                    thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                } else {
                    thumb.classList.remove('border-secondary', 'scale-105', 'shadow-md');
                    thumb.classList.add('border-transparent', 'opacity-60');
                }
            });
        }

        function adjustZoom(delta) {
            currentScale = Math.min(Math.max(0.5, currentScale + delta), 4);
            updateTransform();
        }

        function rotateImage() {
            currentRotation = (currentRotation + 90) % 360;
            updateTransform();
        }

        function resetTransform() {
            currentScale = 1;
            currentRotation = 0;
            translateX = 0;
            translateY = 0;
            updateTransform();
        }

        function updateTransform() {
            const imgWrapper = document.getElementById('previewImageWrapper');
            const zoomBadge = document.getElementById('previewZoomLevel');
            if (imgWrapper) {
                imgWrapper.style.transform = `translate(${translateX}px, ${translateY}px) scale(${currentScale}) rotate(${currentRotation}deg)`;
            }
            if (zoomBadge) {
                zoomBadge.textContent = `${Math.round(currentScale * 100)}%`;
            }
        }
    </script>
}