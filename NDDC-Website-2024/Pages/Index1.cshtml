@page
@using System.Web
@using System.Text.RegularExpressions
@model Index1Model
@{
    ViewData["Title"] = "Home page";
}

<!-- Button trigger modal -->
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal" id="click" style="display:none;">
	Launch modal
</button>

@{
	// Function to strip HTML tags from a string
	string StripHtml(string input)
	{
		return Regex.Replace(input, "<.*?>", string.Empty);
	}
}
<!-- Modal -->
@if (Model.Announcement != null)
{
	<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<h1 class="modal-title fs-5 text-success" id="exampleModalLabel">Public Announcement</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="card" style="border: 0;">
						<div class="card-body">
							<h5 class="card-title">@Model.Announcement.Title</h5>
							<p class="card-text">@Html.Raw(Model.Announcement.Details)</p>
							<a href="#" class="text-success pt-3">Learn more</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}


@if (Model.LiveEvent != null)
{
	<!--Live Events Section-->
	@if(Model.IsEventLive == false)
	{
		<section class="" style="background-color:#003b4952;">
			<div class="container-xxl mt-0" style="">
				<div class="row">
					<div class="col-lg-12 d-flex text-light justify-content-between align-items-center flex-wrap px-5 py-3" style="background-color: #026DB5;">
						<p class="text-light fs-4 fw-bold mb-0">This event will be starting in:</p>
						<div><span class="lead fs-4 fw-bold days pe-2"> </span><span class="lead fs-4 fw-bold pe-2">days</span></div>
						<div><span class="lead fs-4 fw-bold hours pe-2"> </span><span class="lead fs-4 fw-bold pe-2">hours</span></div>
						<div><span class="lead fs-4 fw-bold minutes pe-2"> </span><span class="lead fs-4 fw-bold pe-2">minutes</span></div>
						<div><span class="lead fs-4 fw-bold seconds pe-2"> </span><span class="lead fs-4 fw-bold pe-2">seconds</span></div>



					</div>
					<div class="col-lg-5" style=" background-color:var(--thm-black);">
						<div class="mayor-box" style=" padding-right: 1rem;">
							<div class="section-title-box m-4">
								@if (Model.LiveEvent.StartDate.ToString("dd") == Model.LiveEvent.EndDate.ToString("dd"))
								{
									<div class="lead fw-bold pb-4" style="  color: var(--thm-primary); text-transform: uppercase; letter-spacing: 1px;">

										@* NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd") - @Model.LiveEvent.EndDate.ToString("dd") *@
										NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd")
									</div>

									<!-- section-tagline -->
								}
								else
								{
									<div class="lead fw-bold pb-4" style="  color: var(--thm-primary); text-transform: uppercase; letter-spacing: 1px;">

										@* NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd") *@
										NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd") - @Model.LiveEvent.EndDate.ToString("dd")
									</div>

									<!-- section-tagline -->
								}
								<h2 class="section-title text-light mb-4" style="font-size: 40px;">
									@Model.LiveEvent.Title
								</h2>
								<p class="text-light">@Model.LiveEvent.Summary</p>
								<div class="d-flex pt-4">
									<a asp-route-Id="@Model.LiveEvent.Id" asp-page="/Media/LiveEvent/EventDetails" class="btn btn-primary me-3 px-3 py-2" style="">Learn More</a>
									<a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=@Model.LiveEvent.Title&details=More+help+visit:+https://nddc.gov.ng&dates=@Model.LiveEvent.StartDate.ToString("yyyyMMdd")T080000/@Model.LiveEvent.EndDate.ToString("yyyyMMdd")T170000&ctz=Nigeria" target="_blank" class="btn btn-success text-light fw-bold rounded-0 px-3 py-2"> <i class="fa-solid fa-calendar-days pe-2"></i>Calender</a>
								</div>
							</div><!--section-title-box-->
							<!--mayor-icon-box-->
							<!-- ul -->
						</div><!--mayor-box-->
					</div><div class="col-lg-7" style=" --bs-gutter-x: 0;">
						<div class="">
							<img src="@Model._containerUrl@Model.LiveEvent.BannerImage" alt="Banner Image" class="mw-100 w-100 img-cover" style="height: 600px;">
						</div><!--mayor-img-->
					</div>


					<!--col-lg-6"-->
				</div><!-- row -->

			</div><!-- container -->
		</section>
	}
	else
	{
		<section class="" style="background-color:#003b4952;">
			<div class="container-xxl mt-0" style="">
				<div class="row">
					
					<div class="col-lg-5" style=" background-color:var(--thm-black);">
						<div class="mayor-box" style=" padding-right: 1rem;">
							<div class="section-title-box m-4">
								<div class="lead fw-bold pb-4" style="  color: var(--thm-primary); text-transform: uppercase; letter-spacing: 1px;">
									NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd") - @Model.LiveEvent.EndDate.ToString("dd")
								</div><!-- section-tagline -->
								<h2 class="section-title text-light mb-4" style="font-size: 40px;">
									@Model.LiveEvent.Title
								</h2>
								<p class="text-light">@Model.LiveEvent.Summary</p>
								<div class="d-flex pt-4">
									<a asp-route-Id="@Model.LiveEvent.Id" asp-page="EventDetails" class="btn btn-primary me-3 px-3 py-2" style="">Learn More</a>
									<a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=@Model.LiveEvent.Title&details=More+help+visit:+https://nddc.gov.ng&dates=@Model.LiveEvent.StartDate.ToString("yyyyMMdd")T160000/@Model.LiveEvent.EndDate.ToString("yyyyMMdd")T170000&ctz=Nigeria" target="_blank" class="btn btn-success text-light fw-bold rounded-0 px-3 py-2"> <i class="fa-solid fa-calendar-days pe-2"></i>Calender</a>
								</div>
							</div><!--section-title-box-->
							<!--mayor-icon-box-->
							<!-- ul -->
						</div><!--mayor-box-->
					</div><div class="col-lg-7" style=" --bs-gutter-x: 0;">
						<div class="">

							<iframe  style="width: -webkit-fill-available;" width="700" height="500" src="https://www.youtube.com/embed/@Model.LiveEvent.LiveEventLink" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
						</div><!--mayor-img-->
					</div>


					<!--col-lg-6"-->
				</div><!-- row -->

			</div><!-- container -->
		</section>
		
	}


	<section class="">
		<div class="container">
			<div class="row row-gutter-y-40">
				<div class="col-12 col-lg-4 col-xl-4">
					<div class="service-two-card">
						<div class="service-two-imgbox">
							<div class="service-two-image">
								<img src="/assets/image/services/about-1.jpg" class="img-fluid w-100" style="height: 280px !important; object-fit: cover !important;" alt="Mission Image">
								<a href="service-details.html"></a>
							</div><!-- service-two-image -->
						</div><!-- service-two-imgbox -->
						<div class="service-two-card-content">
							<h4>Mission</h4>
							<p>To offer a lasting solution to the socio-economic difficulties in the Niger Delta region.</p>
							<a href="/WhoWeAre/Vision">
								<i class="fa-solid fa-arrow-right-long"></i>
								<span>Read More</span>
							</a>
						</div><!--service-two-card-content-->
					</div><!--service-two-card-->
				</div><!--col-12 col-lg-4 col-xl-4-->
				<div class="col-12 col-lg-4 col-xl-4">
					<div class="service-two-card">
						<div class="service-two-imgbox">
							<div class="service-two-image">
								<img src="assets/image/services/service-5.png" class="img-fluid w-100" style="height: 280px !important; object-fit: cover !important;" alt="Vision Image">
								<a href="service-details.html"></a>
							</div><!-- service-two-image -->
						</div><!-- service-two-imgbox -->
						<div class="service-two-card-content">
							<h4>Vision</h4>
							<p>
								To accelerate the Niger Delta's transition to a prosperous, stable and peaceful region.
							</p>
							<a href="/WhoWeAre/Vision">
								<i class="fa-solid fa-arrow-right-long"></i>
								<span>Read More</span>
							</a>
						</div><!--service-two-card-content-->
					</div><!--service-two-card-->
				</div><!--col-12 col-lg-4 col-xl-4-->
				<div class="col-12 col-lg-4 col-xl-4">
					<div class="service-link-box">
						<h4 class="section-title">Digital <br>Services</h4>
						<ul class="my-4 py-2">
							<li><a href="/Services/ProjectDatabase/index">Project Database<i class="fa-solid fa-chevron-right"></i></a></li>
							<li><a href="/Services/Jobs">Empowerment Programs <i class="fa-solid fa-chevron-right"></i></a></li>
							<li><a href="/Services/Tenders">Tenders & Adverts<i class="fa-solid fa-chevron-right"></i></a></li>
							<li><a href="/Services/OnlineForms">Online Forms<i class="fa-solid fa-chevron-right"></i></a></li>
							<li><a href="/ServiceGate/index">Service Gate <i class="fa-solid fa-chevron-right"></i></a></li>
							<li><a href="/Services/IReports/index">iReports<i class="fa-solid fa-chevron-right"></i></a></li>
						</ul><!-- ul -->
					</div><!--service-link-box-->
				</div><!--col-12 col-lg-4 col-xl-4-->
			</div><!-- row -->
		</div><!-- container -->
	</section>

	<section class="about-two-section">
		<div class="container">
				<div class="row justify-content-between row-gutter-y-60">
				<div class="col-lg-12 col-xl-6 col-xxl-6">
					<div class="about-two-image">
						<div id="imageHolder" class="">
							<div class="imageHolderDiv">
							<img src="/assets/image/gallery/Chairman.png" alt="Chairman- Chiedu Ebie">
								<img src="/assets/image/gallery/MD.png" alt="Managing Director- Samuel Ogbuku">
								<img src="/assets/image/gallery/EDFA.png" alt="Executive Director, Finance and Administration (EDFA)- Boma Iyaye">
								<img src="/assets/image/gallery/EDP.png" alt="Executive Director, Projects (EDP)- Victor Etim Antai">
								<img src="/assets/image/gallery/EDCS.png" alt="Executive Director of Corporate Services (EDCS)- Ifedayo Abegunde">	
							</div>
						</div>
					</div>
				</div>
				<div class="col-lg-12 col-xl-6 col-xxl-6">
					<div class="about-two-inner pt-0">
						<h2 class="section-title">Welcome to The Niger Delta Development Commission</h2><!-- section-title -->
						<div class="about-two-text">
							<div class="about-two-text-inner-one">
								<p class="lead">"To offer a lasting solution to the socio-economic difficulties of the Niger Delta region."</p><!-- lead -->
							</div><!-- about-two-text-inner-one -->
							<p>Explore our website to unveil our steadfast dedication to fostering sustainable development, empowering communities, and catalyzing positive transformation across the Niger Delta region. From bolstering infrastructure to advancing social welfare initiatives, we are steadfastly committed to creating opportunities and enhancing livelihoods. We invite you to embark on this journey with us towards a future brimming with prosperity and progress.</p>
						</div><!--about-two-text-->
						<div class="about-two-author-content">
							<a href="/WhoWeAre/Vision" class="text-success font-semibold hover:text-blue-700">
								LEARN MORE →
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!--Live Events Section-->
}




