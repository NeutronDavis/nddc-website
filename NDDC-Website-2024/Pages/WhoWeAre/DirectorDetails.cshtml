@page
@model NDDC_Website_2024.Pages.WhoWeAre.DirectorDetailsModel
@{
    Layout = "_Layout";
}

<style>
    .profile-shadow {
        box-shadow: 0px 4px 20px rgba(0, 75, 68, 0.05);
    }
</style>

<!-- Breadcrumbs -->
<section class="max-w-container-max mx-auto px-margin-mobile md:px-gutter py-8">
    <nav class="flex items-center gap-2 text-on-surface-variant font-label-sm">
        <a class="hover:text-primary transition-colors" href="/">Home</a>
        <span class="material-symbols-outlined text-[16px] text-on-surface-variant/50">chevron_right</span>
        <a class="hover:text-primary transition-colors" href="/WhoWeAre/Directors">Our Directors</a>
        <span class="material-symbols-outlined text-[16px] text-on-surface-variant/50">chevron_right</span>
        <span class="text-primary font-bold">Director Details</span>
    </nav>
</section>

<!-- Hero Section -->
<section class="relative overflow-hidden pt-8 pb-section-gap-sm">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter flex flex-col md:flex-row items-center gap-12 lg:gap-24">
        <!-- Portrait with Brand Seal Background -->
        <div class="relative w-full md:w-1/2 flex justify-center lg:justify-start">
            @* <div class="absolute -z-10 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[110%] aspect-square opacity-10">
                <img alt="NDDC Seal" class="w-full h-full object-contain filter grayscale brightness-0" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDo3GCcMFLDV5zP9Mwtlvp0rYVkI01i8BcCiHy8WfiyViTCKjZFezUJSoLxlsTS_T54oihIlttZPngEhd3-GOXcQyXjnM6YBY9434Gv4XkCXjO1r1dh2LhTBm31yZplVMRyjzoMzOYJWbkO-Yz-pQKavsbQkfBojuz6v8FNWwV8tBzHRVKwyzCjcxXtQ5agwMnU6gVqJRaK3epZocHsBsdCOBiSDnLZuFTMniTXkgp2C2cyJZ3VieCaVtHUPKnZApHq9970lUStKn0">
            </div> *@
            @if (Model.DirectorDetails != null)
            {
                <div class="relative p-2 rounded-full border-4 border-primary/10">
                    <div class="rounded-full overflow-hidden w-64 h-64 md:w-80 md:h-80 lg:w-[420px] lg:h-[420px] bg-surface-container profile-shadow">
                        <img class="w-full h-full object-cover grayscale-[20%] hover:grayscale-0 transition-all duration-700 object-top" alt="@Model.DirectorDetails.DirectorName" src="@Model._containerUrl@Model.DirectorDetails.ImageUrl">
                    </div>
                </div>
            }
        </div>
        
        <!-- Identity Information -->
        <div class="w-full md:w-1/2 space-y-6 text-left">
            @if (Model.DirectorDetails != null)
            {
                <div class="space-y-1">
                    <p class="text-secondary font-label-sm uppercase tracking-widest flex items-center gap-2 font-semibold">
                        <span class="w-8 h-[2px] bg-secondary"></span>
                        @Model.DirectorDetails.Position
                    </p>
                    <h1 class="font-headline-lg text-headline-lg lg:text-display-lg text-primary font-bold leading-tight">@Model.DirectorDetails.DirectorName</h1>
                </div>
            }
        </div>
    </div>
</section>

<!-- Biography Content Section -->
<section class="bg-surface-container-lowest py-section-gap-lg">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter grid grid-cols-1 lg:grid-cols-12 gap-16">
        <!-- Main Bio Content -->
        <div class="lg:col-span-8 space-y-12 text-left">
            @if (Model.DirectorDetails != null)
            {
                <div class="space-y-6">
                    <h2 class="font-headline-md text-headline-md text-primary flex items-center gap-3 font-bold">
                        Professional Biography
                        <span class="h-[1px] flex-1 bg-outline-variant/30"></span>
                    </h2>
                    <div class="space-y-6 text-on-surface-variant leading-loose font-body-md text-body-md">
                        @Html.Raw(Model.DirectorDetails.Details)
                    </div>
                </div>
            }
        </div>
        
        <!-- Sidebar / Quick Info -->
        <aside class="lg:col-span-4 space-y-8 text-left">
            <div class="bg-primary text-on-primary p-8 rounded-2xl space-y-6 shadow-xl">
               <h4 class="font-headline-md text-headline-md font-bold" style="color: #6AFE9C;">Key Focus Areas</h4>
                <ul class="space-y-4">
                <ul class="space-y-4">
                    <li class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-secondary-fixed">cloud_sync</span>
                        <span>Digital Transformation</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-secondary-fixed">construction</span>
                        <span>Infrastructure Design</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-secondary-fixed">energy_savings_leaf</span>
                        <span>Energy Sustainability</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-secondary-fixed">security</span>
                        <span>Information Security</span>
                    </li>
                </ul>
            </div>
        </aside>
    </div>
</section>
