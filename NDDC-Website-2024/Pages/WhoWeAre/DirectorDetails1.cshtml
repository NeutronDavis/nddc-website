@page "{Id:int?}"
@model NDDC_Website_2024.Pages.WhoWeAre.DirectorDetails1Model
@{
}
<nav class="" style="--bs-breadcrumb-divider: '>';" @* style="top: 0px; right: 40px; position: absolute; " *@ aria-label="breadcrumb">
	<ol class="breadcrumb bg-dark list-unstyled justify-content-end border-bottom p-2 pe-5" style="--bs-bg-opacity: .1;">
		<li class="breadcrumb-item">
			<a href="/News/News" style="font-size: smaller;color: #003b49;">Our Board</a>
		</li>
		<li class="breadcrumb-item" style="font-size: smaller;color: #003b49;">Board Details (Updated)</li>
	</ol><!-- list-unstyled -->
</nav>

<style>
	#directorMemberImg {
		width: 450px !important;
		height: 450px !important;
		max-width: 100% !important;
		aspect-ratio: 1/1 !important;
		object-fit: cover !important;
		object-position: top center !important;
		border-radius: 50% !important;
		display: block !important;
		margin-left: auto !important;
	}
	@@media (max-width: 991px) {
		#directorMemberImg {
			width: 300px !important;
			height: 300px !important;
			margin: 0 auto !important;
		}
	}
</style>

<section class="testimonial-two-section">
	<div class="testimonial-two-inner" style="background-image: url(/assets/image/bg/board-bg.png);">
		<div class="container">
			<div class="row">
				<div class="col-12 col-lg-6 col-xl-6">
					<div class="testimonial-two-content">
						<div class="section-title-box">
							<div class="section-tagline">
								@Model.DirectorDetails.Position
							</div><!-- section-tagline -->
							<h2 class="section-title">@Model.DirectorDetails.DirectorName</h2>
							@* <h4 class="fw-normal">Chiedu Ebie: The Technocrat and Beacon of the Niger Delta Region</h4> *@
						</div><!--section-title-box-->
					</div><!--testimonial-two-content-->
					<!--testimonial-author-thumb-->
				</div><!--col-lg-4-->
				<!-- col-lg-5 -->
				<div class="col-lg-6">
					<div class="testimonial-two-img" style="display: block !important;">
						<div id="directorMemberCircle" style="width: 450px !important; height: 450px !important; max-width: 100% !important; aspect-ratio: 1/1 !important; border-radius: 50% !important; overflow: hidden !important; margin-left: auto !important; position: relative !important; border: 5px solid white !important; box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;">
							<img src="@Model._containerUrl@Model.DirectorDetails.ImageUrl" style="width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: top center !important; display: block !important;" alt="Director Member Details">
						</div>
					</div><!-- testimonial-two-img -->
				</div><!--col-lg-3-->

			</div><!-- row -->

		</div><!-- container -->
	</div><!-- testimonial-two-inner -->
	<div class="col-12 justify-content-center d-flex mt-5 p-5">
		<div class="col-8 text-dark d-block">
			<p class="text-dark lh-lg">
				@Html.Raw(@Model.DirectorDetails.Details)
			</p>

		</div>

	</div>

</section>