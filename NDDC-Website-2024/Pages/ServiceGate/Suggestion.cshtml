@page
@model NDDC_Website_2024.Pages.ServiceGate.SuggestionModel
@{
	Layout = "_Layout";
}

<!-- Hero / Breadcrumb Section -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
	<div class="max-w-container-max mx-auto text-left">
		<nav class="flex flex-wrap items-center gap-2 mb-4 md:mb-stack-gap text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
			<a class="hover:text-primary transition-colors" href="/">Home</a>
			<span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
			<a class="hover:text-primary transition-colors" href="/ServiceGate/Index">Service Gate</a>
			<span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
			<span class="text-primary font-semibold">Share Suggestions</span>
		</nav>
		<h1 class="font-display-lg text-3xl sm:text-5xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight">
			Submit a Suggestion
		</h1>
		<div class="w-16 sm:w-24 h-1 sm:h-1.5 bg-secondary mt-4 sm:mt-6 rounded-full"></div>
	</div>
</section>

<!-- Suggestion Form Section -->
<section class="py-12 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto">
	<div class="max-w-3xl mx-auto bg-white rounded-2xl p-6 sm:p-10 border border-outline-variant/20 shadow-md text-left">
		<div class="border-b border-outline-variant/15 pb-6 mb-8 text-left">
			<h3 class="text-2xl font-bold text-primary">Help Us Improve Regional Service Delivery</h3>
			<p class="text-on-surface-variant/80 text-xs sm:text-sm mt-1">Your ideas and suggestions play a critical role in shaping NDDC's development projects and community programs.</p>
		</div>

		<form method="post" class="space-y-6">
			<div>
				<label for="SuggestionTitle" class="block text-xs font-bold text-primary uppercase tracking-wider mb-2">Suggestion Topic / Title *</label>
				<input type="text" id="SuggestionTitle" name="SuggestionTitle" required placeholder="e.g. Infrastructure Maintenance Suggestion" class="w-full px-4 py-3 rounded-lg border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm outline-none">
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				<div>
					<label for="name" class="block text-xs font-bold text-primary uppercase tracking-wider mb-2">Your Full Name *</label>
					<input type="text" id="name" name="name" required placeholder="John Doe" class="w-full px-4 py-3 rounded-lg border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm outline-none">
				</div>

				<div>
					<label for="email" class="block text-xs font-bold text-primary uppercase tracking-wider mb-2">Email Address *</label>
					<input type="email" id="email" name="email" required placeholder="example@domain.com" class="w-full px-4 py-3 rounded-lg border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm outline-none">
				</div>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				<div>
					<label for="phone" class="block text-xs font-bold text-primary uppercase tracking-wider mb-2">Phone Number</label>
					<input type="tel" id="phone" name="phone" placeholder="+234..." class="w-full px-4 py-3 rounded-lg border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm outline-none">
				</div>

				<div>
					<label for="location" class="block text-xs font-bold text-primary uppercase tracking-wider mb-2">Location / State</label>
					<input type="text" id="location" name="location" placeholder="e.g. Yenagoa, Bayelsa State" class="w-full px-4 py-3 rounded-lg border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm outline-none">
				</div>
			</div>

			<div>
				<label for="message" class="block text-xs font-bold text-primary uppercase tracking-wider mb-2">Suggestion Details *</label>
				<textarea id="message" name="message" rows="5" required placeholder="Share your suggestions and recommendations in detail..." class="w-full px-4 py-3 rounded-lg border border-outline-variant/30 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm outline-none resize-y"></textarea>
			</div>

			<div class="pt-2 text-center">
				<button type="submit" class="w-full sm:w-auto bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-sm px-10 py-4 rounded-full transition-all duration-300 shadow-md hover:shadow-lg inline-flex items-center justify-center gap-2">
					Submit Suggestion <span class="material-symbols-outlined text-sm">lightbulb</span>
				</button>
			</div>
		</form>
	</div>
</section>