@page
@model NDDC_Website_2024.Pages.ServiceGate.IndexModel
@{
	Layout = "_Layout";
}

<!-- Hero / Breadcrumb Section -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
	<div class="max-w-container-max mx-auto text-left">
		<nav class="flex flex-wrap items-center gap-2 mb-4 md:mb-stack-gap text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
			<a class="hover:text-primary transition-colors" href="/">Home</a>
			<span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
			<span class="text-on-surface-variant">Digital Services</span>
			<span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
			<span class="text-primary font-semibold">Service Gate</span>
		</nav>
		<h1 class="font-display-lg text-3xl sm:text-5xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight">
			Service Gate (SERVICOM)
		</h1>
		<div class="w-16 sm:w-24 h-1 sm:h-1.5 bg-secondary mt-4 sm:mt-6 rounded-full"></div>
	</div>
</section>

<!-- Overview Banner -->
<section class="py-12 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto">
	<div class="bg-white rounded-2xl p-6 sm:p-10 border border-outline-variant/20 shadow-sm text-left relative overflow-hidden">
		<div class="absolute top-0 left-0 w-2 h-full bg-secondary"></div>
		<div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
			<div class="space-y-3 max-w-3xl">
				<span class="bg-secondary/10 text-secondary text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider inline-block">Citizen Service Portal</span>
				<h2 class="text-2xl sm:text-3xl font-bold text-primary">NDDC Citizens Services System</h2>
				<p class="text-on-surface-variant text-sm sm:text-base leading-relaxed">
					The NDDC Citizens Services System (Service Gate), powered by SERVICOM, is designed to enhance transparent and efficient service delivery across the Niger Delta Region. You can submit inquiries, lodge complaints, and provide suggestions directly to dedicated SERVICOM operatives.
				</p>
			</div>
			<a href="/ServiceGate/Enquiry" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-bold text-sm px-8 py-3.5 rounded-full transition-all duration-300 shadow-md hover:shadow-lg flex-shrink-0 inline-flex items-center gap-2">
				Submit Inquiry <span class="material-symbols-outlined text-sm">arrow_forward</span>
			</a>
		</div>
	</div>
</section>

<!-- Quick Action Grid Section -->
<section class="pb-16 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto">
	<div class="text-left mb-8">
		<h3 class="text-xl sm:text-2xl font-bold text-primary">Service Gate Portals</h3>
		<p class="text-on-surface-variant/80 text-xs sm:text-sm">Select a service channel below to get started.</p>
	</div>
	
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
		<!-- Card 1: Enquiry -->
		<a href="/ServiceGate/Enquiry" class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between text-left">
			<div class="space-y-4">
				<div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
					<span class="material-symbols-outlined text-2xl">question_answer</span>
				</div>
				<div>
					<h4 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors">Submit Enquiry</h4>
					<p class="text-xs sm:text-sm text-on-surface-variant/80 mt-1 leading-relaxed">Ask questions regarding NDDC programs, scholarships, or general inquiries.</p>
				</div>
			</div>
			<div class="mt-6 flex items-center text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform">
				Open Portal <span class="material-symbols-outlined text-xs ml-1">arrow_forward</span>
			</div>
		</a>

		<!-- Card 2: iReports -->
		<a href="/Services/IReports/index" class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between text-left">
			<div class="space-y-4">
				<div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
					<span class="material-symbols-outlined text-2xl">campaign</span>
				</div>
				<div>
					<h4 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors">iReports</h4>
					<p class="text-xs sm:text-sm text-on-surface-variant/80 mt-1 leading-relaxed">Project Operations Warning and Early Response system for regional projects.</p>
				</div>
			</div>
			<div class="mt-6 flex items-center text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform">
				Report An Issue <span class="material-symbols-outlined text-xs ml-1">arrow_forward</span>
			</div>
		</a>

		<!-- Card 3: Socials & Connect -->
		<a href="/ServiceGate/Complaint" class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between text-left">
			<div class="space-y-4">
				<div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
					<span class="material-symbols-outlined text-2xl">share</span>
				</div>
				<div>
					<h4 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors">Socials & Connect</h4>
					<p class="text-xs sm:text-sm text-on-surface-variant/80 mt-1 leading-relaxed">Connect with all official NDDC social handles and public communication desks.</p>
				</div>
			</div>
			<div class="mt-6 flex items-center text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform">
				Connect Now <span class="material-symbols-outlined text-xs ml-1">arrow_forward</span>
			</div>
		</a>

		<!-- Card 4: Suggestions -->
		<a href="/ServiceGate/Suggestion" class="group bg-white rounded-2xl p-6 border border-outline-variant/20 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between text-left">
			<div class="space-y-4">
				<div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center group-hover:bg-secondary group-hover:text-white transition-colors duration-300">
					<span class="material-symbols-outlined text-2xl">lightbulb</span>
				</div>
				<div>
					<h4 class="text-lg font-bold text-primary group-hover:text-secondary transition-colors">Submit Suggestion</h4>
					<p class="text-xs sm:text-sm text-on-surface-variant/80 mt-1 leading-relaxed">Provide constructive feedback to help improve NDDC's regional initiatives.</p>
				</div>
			</div>
			<div class="mt-6 flex items-center text-xs font-bold text-secondary group-hover:translate-x-1 transition-transform">
				Share Feedback <span class="material-symbols-outlined text-xs ml-1">arrow_forward</span>
			</div>
		</a>
	</div>
</section>

<!-- Location Map & Contact Strip Section -->
<section class="pb-16 px-4 sm:px-margin-mobile md:px-gutter max-w-container-max mx-auto space-y-8">
	<!-- Google Map Wrapper -->
	<div class="w-full h-80 sm:h-96 md:h-[420px] rounded-2xl overflow-hidden shadow-md border border-outline-variant/20">
		<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3975.985854165265!2d7.017670173929562!3d4.772395541034061!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1069cda9d82836e7%3A0xc34b50422d11500a!2sNDDC%20HEAD%20OFFICE!5e0!3m2!1sen!2sng!4v1700128869284!5m2!1sen!2sng" class="w-full h-full border-0" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
	</div>

	<!-- Information Cards Strip -->
	<div class="bg-primary text-white rounded-2xl p-6 sm:p-8 shadow-xl">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
			<!-- Item 1 -->
			<div class="flex items-start gap-4">
				<div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-secondary-fixed flex-shrink-0">
					<i class="fa-solid fa-phone"></i>
				</div>
				<div>
					<span class="text-xs text-white/60 font-medium uppercase tracking-wider block">Have Questions?</span>
					<strong class="text-sm font-bold text-white block mt-0.5">+234 707 106 0050</strong>
				</div>
			</div>
			<!-- Item 2 -->
			<div class="flex items-start gap-4">
				<div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-secondary-fixed flex-shrink-0">
					<i class="fa-solid fa-clock"></i>
				</div>
				<div>
					<span class="text-xs text-white/60 font-medium uppercase tracking-wider block">Business Hours</span>
					<strong class="text-sm font-bold text-white block mt-0.5">Mon - Fri (9:00am - 5:00pm)</strong>
				</div>
			</div>
			<!-- Item 3 -->
			<div class="flex items-start gap-4">
				<div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-secondary-fixed flex-shrink-0">
					<i class="fa-solid fa-location-dot"></i>
				</div>
				<div>
					<span class="text-xs text-white/60 font-medium uppercase tracking-wider block">Visit Office</span>
					<strong class="text-sm font-bold text-white block mt-0.5">Marine Base, Port Harcourt</strong>
				</div>
			</div>
			<!-- Item 4 -->
			<div class="flex items-start gap-4">
				<div class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-secondary-fixed flex-shrink-0">
					<i class="fa-solid fa-globe"></i>
				</div>
				<div>
					<span class="text-xs text-white/60 font-medium uppercase tracking-wider block">Official Handles</span>
					<div class="flex items-center gap-2 mt-1.5">
						<a href="https://x.com/NDDCOnline" target="_blank" class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-secondary transition-colors"><i class="fa-brands fa-x-twitter text-xs"></i></a>
						<a href="https://web.facebook.com/OfficialNDDC" target="_blank" class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-secondary transition-colors"><i class="fa-brands fa-facebook-f text-xs"></i></a>
						<a href="https://www.linkedin.com/company/officialnddc/" target="_blank" class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-secondary transition-colors"><i class="fa-brands fa-linkedin-in text-xs"></i></a>
						<a href="https://www.instagram.com/nddc_online/" target="_blank" class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-secondary transition-colors"><i class="fa-brands fa-instagram text-xs"></i></a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>