    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js" integrity="sha512-WMEKGZ7L5LWgaPeJtw9MBM4i5w5OSBlSjTjCtSnvFJGSVD26gE5+Td12qN5pvWXhuWaWcVwF++F7aqu9cvqP0A==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    
    <script>
        // Set current year in footer
        document.getElementById("year").innerHTML = new Date().getFullYear();

        // Active nav indicator — highlights the correct top-level nav item based on the current URL
        (function () {
            const path = window.location.pathname.toLowerCase();

            // Map of nav button IDs to the URL prefixes that should activate them
            const navMap = [
                { id: 'nav-home',        prefixes: ['/index', '/'] },
                { id: 'nav-who-we-are', prefixes: ['/whoweare'] },
                { id: 'nav-what-we-do', prefixes: ['/whatwedo', '/services/projectdatabase'] },
                { id: 'nav-news',       prefixes: ['/news'] },
                { id: 'nav-media',      prefixes: ['/media'] },
                { id: 'nav-e-services', prefixes: ['/servicegate', '/services', '/ireports'] },
            ];

            const activeClasses    = ['text-secondary', 'font-semibold'];
            const inactiveClasses  = ['text-on-surface-variant'];

            navMap.forEach(function (entry) {
                const el = document.getElementById(entry.id);
                if (!el) return;

                const isActive = entry.prefixes.some(function (prefix) {
                    // Exact match for home ("/" or "/index"), prefix match for everything else
                    if (prefix === '/') return path === '/' || path === '/index';
                    return path === prefix || path.startsWith(prefix + '/') || path.startsWith(prefix + '?');
                });

                if (isActive) {
                    el.classList.remove(...inactiveClasses);
                    el.classList.add(...activeClasses);
                } else {
                    el.classList.remove(...activeClasses);
                    el.classList.add(...inactiveClasses);
                }
            });
        })();

        // Footer external links helper
        function myYoutube() { window.open("https://www.youtube.com/channel/UCfT-eH7-e1o-tV3P25yC83w"); }
        function myTiktok() { window.open("https://www.tiktok.com/@@nddc_online"); }

        // Mobile drawer navigation triggers
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('mobile-menu-toggle');
            const closeBtn = document.getElementById('mobile-menu-close');
            const drawer = document.getElementById('mobile-nav-drawer');
            const overlay = document.getElementById('mobile-drawer-overlay');
            const content = document.getElementById('mobile-drawer-content');

            function openDrawer() {
                drawer.classList.remove('invisible', 'opacity-0');
                drawer.classList.add('visible', 'opacity-100');
                content.classList.remove('translate-x-full');
                content.classList.add('translate-x-0');
            }

            function closeDrawer() {
                drawer.classList.remove('visible', 'opacity-100');
                drawer.classList.add('invisible', 'opacity-0');
                content.classList.remove('translate-x-0');
                content.classList.add('translate-x-full');
            }

            if (toggleBtn && closeBtn && drawer && overlay && content) {
                toggleBtn.addEventListener('click', openDrawer);
                closeBtn.addEventListener('click', closeDrawer);
                overlay.addEventListener('click', closeDrawer);
            }

            // Accordion menus in mobile menu drawer
            document.querySelectorAll('.mobile-accordion-trigger').forEach(trigger => {
                trigger.addEventListener('click', () => {
                    const targetId = trigger.getAttribute('data-target');
                    const targetEl = document.getElementById(targetId);
                    const icon = trigger.querySelector('.material-symbols-outlined');
                    if (targetEl) {
                        targetEl.classList.toggle('hidden');
                        if (icon) {
                            icon.classList.toggle('rotate-180');
                        }
                    }
                });
            });
        });

        // Transparent Hero Navbar scroll transition for Home Page
        (function () {
            const isHomeBody = document.body.classList.contains('home-transparent-nav');
            const nav = document.querySelector('.nav-main-bar');
            if (!isHomeBody || !nav) return;

            function handleScroll() {
                const hero = document.getElementById('hero-section');
                const heroThreshold = hero ? (hero.offsetHeight - 100) : 450;
                const scrollY = window.scrollY || window.pageYOffset || 0;

                if (scrollY > heroThreshold) {
                    nav.classList.remove('nav-transparent');
                    nav.classList.add('nav-scrolled');
                } else {
                    nav.classList.remove('nav-scrolled');
                    nav.classList.add('nav-transparent');
                }
            }

            window.addEventListener('scroll', handleScroll, { passive: true });
            window.addEventListener('resize', handleScroll, { passive: true });
            handleScroll();
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
