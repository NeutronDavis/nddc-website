    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" integrity="sha512-c42qTSw/wPZ3/5LBzD+Bw5f7bSF2oxou6wEb+I/lqeaKV5FDIfMvvRp772y4jcJLKuGUOpbJMdg/BTl50fJYAw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/8.4.4/swiper-bundle.min.css" integrity="sha512-pJrGHWDVOeiy4UkMtHu0fpD8oLLssFcaW0fsVXUkA1/jDLopa554Z1AZo5SKtekHnnmyat0ipiP0snKDrt0GNg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" type="text/css" href="/assets/css/style.css">
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
    
    <style>
        body {
            background-color: theme('colors.background');
            color: theme('colors.on-background');
        }
        html, body, * {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }
        html::-webkit-scrollbar,
        body::-webkit-scrollbar,
        *::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* Topbar & Navbar height variables — used to offset the fixed nav and body wrapper */
        :root {
            --topbar-h: 28px;
            --nav-h: 52px;
        }

        /* Fix top margin for body when fixed header is active */
        .page-wrapper-fixed-nav {
            margin-top: calc(var(--nav-h) + var(--topbar-h));
        }
        /* On mobile: topbar is hidden by style.css, only the nav remains */
        @@media (max-width: 1199px) {
            .page-wrapper-fixed-nav { margin-top: var(--nav-h); }
            .nav-main-bar { top: 0 !important; }
        }

        /* ---------------------------------------------------- */
        /* Home Page Transparent-to-Filled Hero Navbar Styles    */
        /* ---------------------------------------------------- */
        .nav-main-bar {
            transition: background-color 0.35s ease, backdrop-filter 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease, top 0.35s ease;
        }

        /* Topbar stays fixed at top: 0 */
        body.home-transparent-nav .topbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 60;
        }

        /* Body wrapper top-margin zero on home page so hero starts directly behind transparent header */
        body.home-transparent-nav .page-wrapper-fixed-nav {
            margin-top: 0 !important;
        }

        /* Base Transparent Nav State - anchored directly under topbar (top: var(--topbar-h)) */
        body.home-transparent-nav .nav-main-bar.nav-transparent {
            background-color: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border-bottom-color: transparent !important;
            box-shadow: none !important;
            top: var(--topbar-h) !important;
        }

        @@media (max-width: 1199px) {
            body.home-transparent-nav .nav-main-bar.nav-transparent {
                top: 0 !important;
            }
        }

        /* Text & icon styling in transparent mode */
        body.home-transparent-nav .nav-main-bar.nav-transparent .nav-link-item,
        body.home-transparent-nav .nav-main-bar.nav-transparent button.nav-link-item,
        body.home-transparent-nav .nav-main-bar.nav-transparent #mobile-menu-toggle {
            color: rgba(255, 255, 255, 0.95) !important;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
        }

        body.home-transparent-nav .nav-main-bar.nav-transparent .nav-link-item:hover,
        body.home-transparent-nav .nav-main-bar.nav-transparent button.nav-link-item:hover {
            color: #ffffff !important;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.85);
        }

        body.home-transparent-nav .nav-main-bar.nav-transparent .nav-link-item.text-secondary {
            color: #6afe9c !important;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
        }

        body.home-transparent-nav .nav-main-bar.nav-transparent .material-symbols-outlined {
            color: inherit !important;
        }

        /* Dropdown popover containers in transparent mode - remain crisp white with dark text */
        body.home-transparent-nav .nav-main-bar.nav-transparent .group > div {
            background-color: #ffffff !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
            border: 1px solid rgba(0, 0, 0, 0.08) !important;
        }

        body.home-transparent-nav .nav-main-bar.nav-transparent .group > div a {
            color: #3f4947 !important;
            text-shadow: none !important;
        }

        body.home-transparent-nav .nav-main-bar.nav-transparent .group > div a:hover {
            color: #00322d !important;
            background-color: #f0fdf4 !important;
        }

        /* Filled / Scrolled Nav State - stays below topbar (top: var(--topbar-h)) with solid white glass fill */
        body.home-transparent-nav .nav-main-bar.nav-scrolled {
            top: var(--topbar-h) !important;
            background-color: rgba(255, 255, 255, 0.97) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.08) !important;
        }

        @@media (max-width: 1199px) {
            body.home-transparent-nav .nav-main-bar.nav-scrolled {
                top: 0 !important;
            }
        }

        body.home-transparent-nav .nav-main-bar.nav-scrolled .nav-link-item,
        body.home-transparent-nav .nav-main-bar.nav-scrolled button.nav-link-item {
            color: #3f4947 !important;
            text-shadow: none !important;
        }

        body.home-transparent-nav .nav-main-bar.nav-scrolled .nav-link-item:hover,
        body.home-transparent-nav .nav-main-bar.nav-scrolled button.nav-link-item:hover {
            color: #00322d !important;
        }

        body.home-transparent-nav .nav-main-bar.nav-scrolled .nav-link-item.text-secondary {
            color: #006d37 !important;
            text-shadow: none !important;
        }

        body.home-transparent-nav .nav-main-bar.nav-scrolled #mobile-menu-toggle {
            color: #3f4947 !important;
        }

        /* Force standard links to not inherit blue colors from bootstrap default */
        a {
            color: inherit;
            text-decoration: none !important;
        }
        
        /* Specific overrides for color collisions between Tailwind and Bootstrap */
        .text-primary {
            color: #00322d !important;
        }
        .bg-primary {
            background-color: #00322d !important;
        }
        .text-secondary {
            color: #006d37 !important;
        }
        .bg-secondary {
            background-color: #006d37 !important;
        }
        .text-on-primary {
            color: #ffffff !important;
        }
        .text-on-secondary {
            color: #ffffff !important;
        }
        .text-on-surface-variant {
            color: #3f4947 !important;
        }
        
        /* Footer Links Specific Override */
        .footer a {
            color: rgba(255, 255, 255, 0.8) !important;
            text-decoration: none !important;
        }
        .footer a:hover {
            color: #6afe9c !important;
        }
        .footer-widget-socials a {
            color: #ffffff !important;
        }
        /* Topbar Background, Socials & Contact Icon Colors */
        .topbar,
        .topbar-inner {
            background-color: #002824 !important;
            height: 28px !important;
            min-height: 28px !important;
            line-height: 1 !important;
            padding-top: 0 !important;
            padding-bottom: 0 !important;
        }
        .topbar-inner {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
        }
        .topbar-left {
            display: flex !important;
            align-items: center !important;
            height: 100% !important;
        }
        .topbar-socials {
            background-color: #006D37 !important;
            height: 28px !important;
            min-height: 28px !important;
            padding: 0 12px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            line-height: 1 !important;
        }
        .topbar-socials a {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            line-height: 1 !important;
            font-size: 12px !important;
        }
        .topbar-info {
            height: 28px !important;
            padding: 0 10px !important;
            display: flex !important;
            align-items: center !important;
            line-height: 1 !important;
        }
        .topbar-info ul {
            display: flex !important;
            align-items: center !important;
            margin: 0 !important;
            padding: 0 !important;
            list-style: none !important;
        }
        .topbar-info ul li {
            display: flex !important;
            align-items: center !important;
            line-height: 1 !important;
            margin-bottom: 0 !important;
        }
        .topbar-text,
        .topbar-text-div,
        .topbar-text a,
        .topbar-text span {
            font-size: 12px !important;
            line-height: 1 !important;
            display: inline-flex !important;
            align-items: center !important;
            margin-top: 0 !important;
            margin-bottom: 0 !important;
        }
        .topbar-icon {
            display: inline-flex !important;
            align-items: center !important;
        }
        .topbar-icon i {
            color: #006D37 !important;
            font-size: 12px !important;
            line-height: 1 !important;
        }

        .bottom-footer {
            padding: 15px 0 !important;
        }
    </style>
</head>
<body class="antialiased selection:bg-secondary-container selection:text-on-secondary-container @(isHomePage ? "home-transparent-nav" : "")">

    <!-- Topbar: social icons + latest news ticker + contact info -->
    <div class="topbar fixed top-0 left-0 w-full z-[60]">
        <div class="topbar-inner">
            <div class="topbar-left">
                <div class="topbar-socials">
                    <a onclick="myYoutube()" style="cursor:pointer"><i class="fa-brands fa-youtube text-white"></i></a>
                    <a href="https://x.com/NDDCOnline" target="_blank"><i class="fa-brands fa-x-twitter"></i></a>
                    <a onclick="myTiktok()" style="cursor:pointer"><i class="fa-brands fa-tiktok text-white"></i></a>
                    <a href="https://web.facebook.com/OfficialNDDC" target="_blank"><i class="fa-brands fa-facebook"></i></a>
                    <a href="https://www.linkedin.com/company/officialnddc/" target="_blank"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="https://www.instagram.com/nddc_online/" target="_blank"><i class="fa-brands fa-instagram"></i></a>
                </div><!--topbar-socials-->

                <div class="topbar-info">
                    <ul>
                        <li>
                            <div class="topbar-text-div fw-bold">
                                <span>Latest News</span>
                            </div>
                        </li>
                        <li>
                            <div class="topbar-text-div">
                                <span class="opacity-40 text-xs px-1">|</span>
                            </div>
                        </li>
                        <li>
                            <div class="topbar-text-div">
                                @await Component.InvokeAsync("LatestNews")
                            </div>
                        </li>
                    </ul>
                </div><!--topbar-info-->
            </div><!-- topbar-left -->

            <div class="topbar-left">
                <div class="topbar-info">
                    <ul>
                        <li>
                            <div class="topbar-icon">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div class="topbar-text">
                                <a href="mailto:info@nddc.gov.ng">info@nddc.gov.ng</a>
                            </div>
                        </li>
                        <li>
                            <div class="topbar-icon">
                                <i class="fa-solid fa-clock"></i>
                            </div>
                            <div class="topbar-text">
                                <span>Open Hours: Mon - Fri 8.00 am - 5.00 pm</span>
                            </div>
                        </li>
                    </ul>
                </div><!--topbar-info-->
            </div><!--topbar-right-->
        </div><!-- topbar-inner -->
    </div><!--topbar-->

    <!-- TopNavBar (Tailwind Visual Design + Dropdowns) -->
    <nav class="nav-main-bar fixed w-full z-50 @(isHomePage ? "nav-transparent" : "bg-white/95 backdrop-blur-md border-b border-outline-variant/30 shadow-sm") h-[52px]" style="top: var(--topbar-h)">
        <div class="max-w-container-max mx-auto px-gutter flex justify-between items-center h-full">
            <div class="flex items-center gap-4">
                <a href="/index" class="flex items-center">
                    <img src="/assets/image/nddclogo.png" alt="NDDC Logo" class="h-10 md:h-11 w-auto object-contain">
                </a>
            </div>
            
            <!-- Desktop Navigation Links -->
            <div class="hidden md:flex items-center gap-8 h-full">
                <!-- Who We Are Dropdown -->
