	</section>

	<section class="about-two-section py-8 md:py-16">
		<div class="container px-4 md:px-gutter">
			<div class="row justify-content-between row-gutter-y-60">
				<div class="col-lg-12 col-xl-6 col-xxl-6 reveal-init reveal-fade-left">
					<div class="about-two-image">
						<div id="imageHolder" class="">
							<div class="imageHolderDiv">
								<img src="/assets/image/gallery/Chairman.png" alt="Chairman- Chiedu Ebie">
								<img src="/assets/image/gallery/MD.png" alt="Managing Director- Samuel Ogbuku">
								<img src="/assets/image/gallery/EDFA.png" alt="Executive Director, Finance and Administration (EDFA)- Boma Iyaye">
								<img src="/assets/image/gallery/EDP.png" alt="Executive Director, Projects (EDP)- Victor Etim Antai">
								<img src="/assets/image/gallery/EDCS.png" alt="Executive Director of Corporate Services (EDCS)- Ifedayo Abegunde">	
							</div>
						</div>
					</div>
				</div>
				<div class="col-lg-12 col-xl-6 col-xxl-6 reveal-init reveal-fade-right">
					<div class="about-two-inner pt-4 md:pt-0">
						<h2 class="section-title text-2xl sm:text-3xl font-bold text-primary mb-4">Welcome to The Niger Delta Development Commission</h2><!-- section-title -->
						<div class="about-two-text space-y-4 text-sm sm:text-base text-on-surface-variant leading-relaxed">
							<div class="about-two-text-inner-one">
								<p class="lead italic font-semibold text-primary text-base sm:text-lg">"To offer a lasting solution to the socio-economic difficulties of the Niger Delta region."</p><!-- lead -->
							</div><!-- about-two-text-inner-one -->
							<p>Explore our website to unveil our steadfast dedication to fostering sustainable development, empowering communities, and catalyzing positive transformation across the Niger Delta region. From bolstering infrastructure to advancing social welfare initiatives, we are steadfastly committed to creating opportunities and enhancing livelihoods. We invite you to embark on this journey with us towards a future brimming with prosperity and progress.</p>
						</div><!--about-two-text-->
						<div class="about-two-author-content mt-6">
							<a href="/WhoWeAre/Vision" class="text-secondary font-bold hover:underline inline-flex items-center text-sm tracking-wider uppercase">
								LEARN MORE →
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- News Point Section -->
	@{
		var newsList = Model.NewsList ?? new List<MyNewsModel>();
		var mainNews = newsList.FirstOrDefault();
		var otherNews = newsList.Skip(1).Take(4).ToList();
		
		string GetImageUrl(MyNewsModel news)
		{
			if (news == null || string.IsNullOrEmpty(news.ImageUrl)) return "https://lh3.googleusercontent.com/aida-public/AB6AXuBMCly9Q7Ibo8R3azeo0P3fvFhksh6QlS6LwxXGJv-6fX4Pt_o52shms7-s_iMhQYl4qBl5j1RRQkgJ-IOiK-Kv2PjndbLnx0LhSykLYECgRl1Zox5pWnkijLY-3zJpjV6nJ_UAuYXLGR4cClvc1oYSKVAp5lbEpq_Bd6vFsdKNlg4inIU-8oV1nfa3eYl6ps5BshN_5BAxgkq-ckWBNP9WJUWZxFSzqUup6mmyisDKkm6CgV-OSpM6gN7RgZiJqykkgk9qKnFH-S8";
			return news.ImageUrl.StartsWith("http") ? news.ImageUrl : $"{Model._containerUrl}{news.ImageUrl}";
		}
		
		var mainNewsImage = mainNews != null ? GetImageUrl(mainNews) : "";
	}

	@if (mainNews != null)
	{
		<section class="py-10 md:py-section-gap-lg bg-white">
			<div class="max-w-container-max mx-auto px-4 md:px-gutter">
				<div class="border-b border-gray-300 pb-4 mb-6 md:mb-10 text-left flex justify-between items-end">
					<h3 class="bg-secondary text-white font-bold px-3 py-1.5 text-xs md:text-sm uppercase tracking-widest leading-none">
						Never miss what we are up to
					</h3>
				</div>

				<!-- Grid Layout -->
				<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10">
					<!-- Left Column: Main News Featured Card (lg:col-span-5) -->
					<div class="lg:col-span-5 flex flex-col justify-between text-left reveal-init reveal-fade-left">
						<a asp-page="/News/NewsDetails" asp-route-nid="@mainNews.NID" class="block group">
							<div class="relative w-full aspect-[16/10] bg-gray-100 overflow-hidden rounded-sm border border-gray-100 shadow-sm">
								<img id="news-featured-img" alt="Featured News Image" class="w-full h-full object-cover transition-opacity duration-300 ease-in-out opacity-100" src="@mainNewsImage">
								<!-- Badge and Date Strip -->
								<div class="absolute bottom-0 inset-x-0 bg-white/95 border-t border-gray-200 flex justify-between items-center h-10 px-4">
									<span class="bg-secondary text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-wider">News</span>
									<span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">@mainNews.PublishDate.ToString("MMMM dd, yyyy")</span>
								</div>
							</div>
							<h2 class="font-headline-lg text-lg sm:text-xl md:text-2xl text-primary font-bold mt-4 md:mt-6 leading-snug group-hover:text-secondary transition-colors duration-300">
								@mainNews.Subject
							</h2>
						</a>
					</div>

					<!-- Right Column: 2x2 Grid of Smaller News Items (lg:col-span-7) -->
					<div class="lg:col-span-7 flex flex-col justify-between reveal-init reveal-fade-right">
						@if (otherNews.Any())
						{
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-0 relative">
								@for (int i = 0; i < otherNews.Count; i++)
								{
									var news = otherNews[i];
									var newsImage = GetImageUrl(news);
									
									string borderClasses = "border-b border-gray-200 pb-6 md:pb-8 ";
									if (otherNews.Count == 4)
									{
										if (i == 0) borderClasses += "md:border-r md:pr-8 md:pb-10";
										else if (i == 1) borderClasses += "md:pl-8 md:pb-10";
										else if (i == 2) borderClasses += "md:border-r md:border-b-0 pt-0 md:pt-10 md:pr-8 md:pb-0";
										else if (i == 3) borderClasses = "pt-0 md:pt-10 md:pl-8";
									}
									else if (otherNews.Count == 3)
									{
										if (i == 0) borderClasses += "md:border-r md:pr-8 md:pb-10";
										else if (i == 1) borderClasses += "md:pl-8 md:pb-10";
										else if (i == 2) borderClasses = "md:border-r md:border-b-0 pt-0 md:pt-10 md:pr-8";
									}
									else if (otherNews.Count == 2)
									{
										if (i == 0) borderClasses += "md:border-r md:pr-8 md:pb-0";
										else if (i == 1) borderClasses = "md:pl-8";
									}
									else if (otherNews.Count == 1)
									{
										borderClasses = "pb-6 md:pb-0";
									}
									
									<div class="text-left flex flex-col justify-between min-h-[9rem] md:h-44 @borderClasses"
									     onmouseenter="changeFeaturedImage('@newsImage')"
									     onmouseleave="resetFeaturedImage()">
										<div>
											<span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider block mb-2">@news.PublishDate.ToString("MMMM dd, yyyy")</span>
											<h4 class="font-body-lg font-bold text-gray-900 leading-snug hover:text-secondary cursor-pointer transition-colors duration-200 line-clamp-3 text-sm sm:text-base">
												<a asp-page="/News/NewsDetails" asp-route-nid="@news.NID">@news.Subject</a>
											</h4>
										</div>
										<div class="mt-3">
											<a asp-page="/News/NewsDetails" asp-route-nid="@news.NID" class="inline-flex items-center text-xs font-bold text-secondary hover:text-primary transition-colors tracking-widest uppercase">
												Read Post 
												<span class="material-symbols-outlined text-xs ml-1 font-bold">double_arrow</span>
											</a>
										</div>
									</div>
								}
							</div>
						}
						else
						{
							<div class="flex items-center justify-center h-full border border-dashed border-gray-200 rounded-lg p-8">
								<p class="text-gray-400 text-sm">No additional news updates are available.</p>
							</div>
						}

						<!-- View All Button Grid-aligned at bottom right -->
						<div class="flex justify-end mt-8 lg:mt-6">
							<a href="/News/News" class="inline-flex items-center bg-[#012520] hover:bg-secondary text-white font-bold transition-all duration-300 text-xs tracking-wider">
								<span class="px-6 py-3.5 border-r border-white/10 uppercase">View All News</span>
								<span class="px-4 py-3.5 flex items-center justify-center">
									<span class="material-symbols-outlined text-xs">double_arrow</span>
								</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<script>
			let originalNewsImage = "@mainNewsImage";
			function changeFeaturedImage(newSrc) {
				const img = document.getElementById('news-featured-img');
				if (img) {
					img.style.opacity = '0';
					setTimeout(() => {
						img.src = newSrc;
						img.style.opacity = '1';
					}, 150);
				}
			}
			function resetFeaturedImage() {
				changeFeaturedImage(originalNewsImage);
			}
		</script>
	}

	<!-- Core Focus Section -->
	<section class="relative py-12 md:py-section-gap-lg overflow-hidden bg-primary">
		<!-- Background image overlay -->
		<div class="absolute inset-0 z-0">
