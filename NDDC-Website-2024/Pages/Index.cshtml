						{
							@for (int i = 0; i < Model.Testimonials.Count; i++)
							{
								<button class="t-dot w-2.5 h-2.5 rounded-full transition-all @(i == 0 ? "bg-secondary" : "bg-on-primary/30")" data-t-to="@i"></button>
							}
						}
					</div>
				</div>
			</div>
		</div>
