					<span class="font-label-sm text-xs sm:text-label-sm text-on-surface">Our Mission</span>
				</a>
				<!-- Item 2 -->
				<a class="bg-white rounded-xl p-4 sm:p-6 shadow-[0px_4px_20px_rgba(0,75,68,0.05)] hover:-translate-y-1 hover:shadow-lg transition-all duration-300 flex flex-col items-center text-center group border-b-2 border-transparent hover:border-secondary" href="/WhoWeAre/BoardDetails">
					<div class="w-10 h-10 sm:w-12 sm:h-12 bg-surface-container rounded-full flex items-center justify-center mb-3 sm:mb-4 group-hover:bg-secondary/10 transition-colors">
