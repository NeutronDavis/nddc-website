@section Scripts {
	<!-- Scripts for Animations, Slider, and Interactions -->
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			// 1. Hero Carousel Controller
			const slides = document.querySelectorAll('.hero-slide');
			const dots = document.querySelectorAll('.hero-dot');
			let activeIndex = 0;
			let slideInterval = null;

			function showSlide(index) {
				if (slides.length === 0) return;
				slides.forEach((slide, idx) => {
					if (idx === index) {
						slide.classList.remove('opacity-0', 'pointer-events-none');
						slide.classList.add('opacity-100');
					} else {
						slide.classList.remove('opacity-100');
						slide.classList.add('opacity-0', 'pointer-events-none');
					}
				});
				dots.forEach((dot, idx) => {
					if (idx === index) {
						dot.classList.add('w-12', 'bg-secondary');
						dot.classList.remove('w-8', 'bg-on-primary/30');
					} else {
						dot.classList.remove('w-12', 'bg-secondary');
						dot.classList.add('w-8', 'bg-on-primary/30');
					}
				});
				activeIndex = index;
			}

			function nextSlide() {
				let nextIdx = (activeIndex + 1) % slides.length;
				showSlide(nextIdx);
			}

			function startAutoplay() {
				if (slides.length > 1) {
					slideInterval = setInterval(nextSlide, 5000);
				}
			}

			function stopAutoplay() {
				if (slideInterval) clearInterval(slideInterval);
			}

			dots.forEach((dot, idx) => {
				dot.addEventListener('click', () => {
					stopAutoplay();
					showSlide(idx);
					startAutoplay();
				});
			});

			startAutoplay();

			// 2. Photo Speak Horizontal Scrolling & Autoplay
			const container = document.getElementById('photo-speak-container');
			const prevBtn = document.getElementById('photo-prev');
			const nextBtn = document.getElementById('photo-next');

			if (container && prevBtn && nextBtn) {
				let scrollInterval = null;
				let isUserInteracting = false;
				let interactionTimeout = null;

				function getScrollAmount() {
					const card = container.querySelector('.group.relative.overflow-hidden');
					return card ? card.offsetWidth + 24 : container.offsetWidth / 2; // 24 is gap-6 (1.5rem)
				}

				function autoScroll() {
					if (isUserInteracting) return;
					
					const scrollAmount = getScrollAmount();
					const maxScroll = container.scrollWidth - container.clientWidth;
					
					if (container.scrollLeft >= maxScroll - 10) {
						container.scrollTo({
							left: 0,
							behavior: 'smooth'
						});
					} else {
						container.scrollBy({
							left: scrollAmount,
							behavior: 'smooth'
						});
					}
				}

				function startAutoScroll() {
					stopAutoScroll();
					scrollInterval = setInterval(autoScroll, 4000);
				}

				function stopAutoScroll() {
					if (scrollInterval) clearInterval(scrollInterval);
				}

				function resetInteractionDelay() {
					isUserInteracting = true;
					stopAutoScroll();
					if (interactionTimeout) clearTimeout(interactionTimeout);
					interactionTimeout = setTimeout(() => {
						isUserInteracting = false;
						startAutoScroll();
					}, 5000);
				}

				prevBtn.addEventListener('click', () => {
					resetInteractionDelay();
					const scrollAmount = getScrollAmount();
					if (container.scrollLeft <= 10) {
						container.scrollTo({
							left: container.scrollWidth,
							behavior: 'smooth'
						});
					} else {
						container.scrollBy({
							left: -scrollAmount,
							behavior: 'smooth'
						});
					}
				});

				nextBtn.addEventListener('click', () => {
					resetInteractionDelay();
					const scrollAmount = getScrollAmount();
					const maxScroll = container.scrollWidth - container.clientWidth;
					if (container.scrollLeft >= maxScroll - 10) {
						container.scrollTo({
							left: 0,
							behavior: 'smooth'
						});
					} else {
						container.scrollBy({
							left: scrollAmount,
							behavior: 'smooth'
						});
					}
				});

				container.addEventListener('mouseenter', () => { 
					isUserInteracting = true; 
					stopAutoScroll(); 
				});
				container.addEventListener('mouseleave', () => { 
					isUserInteracting = false; 
					startAutoScroll(); 
				});
				container.addEventListener('touchstart', () => { 
					resetInteractionDelay();
				}, { passive: true });

				startAutoScroll();
			}

			// 3. Testimonial Slideshow Controller
			const tSlides = document.querySelectorAll('.testimonial-slide');
			const tDots = document.querySelectorAll('.t-dot');
			let activeT = 0;
			let testimonialInterval = null;

			function showTestimonial(index) {
				if (tSlides.length === 0) return;
				tSlides.forEach((slide, idx) => {
					if (idx === index) {
						slide.classList.remove('hidden');
						slide.classList.add('flex');
					} else {
						slide.classList.remove('flex');
						slide.classList.add('hidden');
					}
				});
				tDots.forEach((dot, idx) => {
					if (idx === index) {
						dot.classList.add('bg-secondary');
						dot.classList.remove('bg-on-primary/30');
					} else {
						dot.classList.remove('bg-secondary');
						dot.classList.add('bg-on-primary/30');
					}
				});
				activeT = index;
			}

			// Testimonial Autoplay logic (only if there are dots)
			if (tDots.length > 1) {
				testimonialInterval = setInterval(() => {
					let nextIdx = (activeT + 1) % tSlides.length;
					showTestimonial(nextIdx);
				}, 6000);
			}

			tDots.forEach((dot, idx) => {
				dot.addEventListener('click', () => {
					if (testimonialInterval) clearInterval(testimonialInterval);
					showTestimonial(idx);
				});
			});

			// 4. Scroll Reveal Intersection Observer
			const revealElements = document.querySelectorAll('.reveal-init');
			
			const observerOptions = {
				root: null,
				rootMargin: '0px 0px -80px 0px',
				threshold: 0.1
			};

			const revealObserver = new IntersectionObserver((entries, observer) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('reveal-active');
						observer.unobserve(entry.target);
					}
				});
			}, observerOptions);

			revealElements.forEach(element => {
				revealObserver.observe(element);
			});
		});
	</script>
}
