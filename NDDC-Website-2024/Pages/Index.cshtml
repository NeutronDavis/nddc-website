							<span class="material-symbols-outlined text-xl">mail</span>
						</div>
						<input type="email" required placeholder="Enter your email address..." class="w-full bg-transparent px-3 py-3 text-sm text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none border-0">
						<button type="submit" class="bg-[#003831] hover:bg-[#002621] text-white font-bold text-xs sm:text-sm px-6 sm:px-7 py-3 sm:py-3.5 rounded-xl transition-all duration-300 flex items-center gap-2 shadow-md hover:shadow-xl active:scale-95 flex-shrink-0 cursor-pointer border-0 group/btn">
							<span>Subscribe</span>
							<span class="material-symbols-outlined text-base group-hover/btn:translate-x-1 transition-transform">send</span>
						</button>
					</form>
				</div>
			</div>
		</div>
	</section>

@section Scripts {
	<!-- Scripts for Animations, Slider, and Interactions -->
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			// 1. Hero Carousel Controller (Custom Yellow Circles + Progress Line)
			const heroSlides = document.querySelectorAll('.hero-slide');
			const heroPrevBtn = document.getElementById('hero-prev-btn');
			const heroNextBtn = document.getElementById('hero-next-btn');
			const heroProgressTrack = document.getElementById('hero-progress-track');
			const heroProgressBar = document.getElementById('hero-progress-bar');

			let heroActiveIndex = 0;
			let heroAnimFrame = null;
			const HERO_SLIDE_DURATION = 5000; // 5 seconds per slide

			function setProgressBarWidth(pct) {
				if (heroProgressBar) {
					heroProgressBar.style.setProperty('width', `${pct}%`, 'important');
				}
			}

			function showHeroSlide(index) {
				if (!heroSlides || heroSlides.length === 0) return;

				const totalSlides = heroSlides.length;
				heroActiveIndex = (index + totalSlides) % totalSlides;

				heroSlides.forEach((slide, idx) => {
					if (idx === heroActiveIndex) {
						slide.classList.remove('opacity-0', 'pointer-events-none');
						slide.classList.add('opacity-100');
					} else {
						slide.classList.remove('opacity-100');
						slide.classList.add('opacity-0', 'pointer-events-none');
					}
				});

				startProgressAndTimer();
			}

			function startProgressAndTimer() {
				if (heroAnimFrame) {
					cancelAnimationFrame(heroAnimFrame);
					heroAnimFrame = null;
				}

				if (!heroSlides || heroSlides.length === 0) return;

				// Immediately reset/reduce progress bar to 0% when slide changes
				setProgressBarWidth(0);

				if (heroSlides.length <= 1) {
					setProgressBarWidth(100);
					return;
				}

				const startTime = performance.now();

				function step(now) {
					const elapsed = now - startTime;
					const progress = Math.min(elapsed / HERO_SLIDE_DURATION, 1);

					setProgressBarWidth(progress * 100);

					if (progress < 1) {
						heroAnimFrame = requestAnimationFrame(step);
					} else {
						showHeroSlide(heroActiveIndex + 1);
					}
				}

				heroAnimFrame = requestAnimationFrame(step);
			}

			if (heroPrevBtn) {
				heroPrevBtn.addEventListener('click', () => {
					showHeroSlide(heroActiveIndex - 1);
				});
			}

			if (heroNextBtn) {
				heroNextBtn.addEventListener('click', () => {
					showHeroSlide(heroActiveIndex + 1);
				});
			}

			if (heroProgressTrack) {
				heroProgressTrack.addEventListener('click', (e) => {
					const totalSlides = heroSlides.length;
					if (totalSlides <= 1) return;

					const rect = heroProgressTrack.getBoundingClientRect();
					const clickX = e.clientX - rect.left;
					const width = rect.width;
					const fraction = Math.max(0, Math.min(0.99, clickX / width));
					const targetIndex = Math.floor(fraction * totalSlides);

					showHeroSlide(targetIndex);
				});
			}

			showHeroSlide(0);

			const container = document.getElementById('photo-speak-container');
			const prevBtn = document.getElementById('photo-prev');
			const nextBtn = document.getElementById('photo-next');
			const progressTrack = document.getElementById('photo-progress-track');
			const progressBar = document.getElementById('photo-progress-bar');
			const slideCounter = document.getElementById('photo-slide-counter');
			const dotsContainer = document.getElementById('photo-dots-container');

			if (container && prevBtn && nextBtn) {
				const cards = Array.from(container.querySelectorAll('.photo-speak-card'));
				let scrollInterval = null;
				let isUserInteracting = false;
				let interactionTimeout = null;
				let activeIndex = 0;

				// Generate Pagination Dots
				if (dotsContainer && cards.length > 0) {
					dotsContainer.innerHTML = '';
					cards.forEach((_, idx) => {
						const dot = document.createElement('button');
						dot.type = 'button';
						dot.ariaLabel = `Go to slide ${idx + 1}`;
						dot.className = idx === 0 
							? 'w-6 h-2 bg-[#006D37] rounded-full transition-all duration-300' 
							: 'w-2 h-2 bg-outline-variant/40 hover:bg-[#006D37]/60 rounded-full transition-all duration-300 cursor-pointer';
						dot.addEventListener('click', () => {
							resetInteractionDelay();
							scrollToCard(idx);
						});
						dotsContainer.appendChild(dot);
					});
				}

				// Click on Progress Track to seek slide
				if (progressTrack) {
					progressTrack.addEventListener('click', (e) => {
						if (!cards.length) return;
						const rect = progressTrack.getBoundingClientRect();
						const clickX = e.clientX - rect.left;
						const fraction = Math.max(0, Math.min(0.99, clickX / rect.width));
						const targetIndex = Math.floor(fraction * cards.length);
						resetInteractionDelay();
						scrollToCard(targetIndex);
					});
				}

				function scrollToCard(index) {
					if (index >= 0 && index < cards.length) {
						const card = cards[index];
						const containerRect = container.getBoundingClientRect();
						const cardRect = card.getBoundingClientRect();
						const targetScrollLeft = container.scrollLeft + (cardRect.left - containerRect.left) - (containerRect.width / 2) + (cardRect.width / 2);
						container.scrollTo({
							left: targetScrollLeft,
							behavior: 'smooth'
						});
					}
				}

				function updateActiveState() {
					if (!cards.length) return;

					const containerRect = container.getBoundingClientRect();
					const containerCenter = containerRect.left + containerRect.width / 2;
					let closestIndex = 0;
					let minDistance = Infinity;

					cards.forEach((card, idx) => {
						const cardRect = card.getBoundingClientRect();
						const cardCenter = cardRect.left + cardRect.width / 2;
						const distance = Math.abs(containerCenter - cardCenter);

						if (distance < minDistance) {
							minDistance = distance;
							closestIndex = idx;
						}
					});

					activeIndex = closestIndex;

					// Update Card Focus Styles
					cards.forEach((card, idx) => {
						if (idx === activeIndex) {
							card.classList.add('scale-100', 'sm:scale-105', 'opacity-100', 'shadow-[0_20px_40px_rgba(0,109,55,0.14)]', 'border-[#006D37]/40', 'z-10');
							card.classList.remove('scale-95', 'opacity-70', 'shadow-none', 'border-outline-variant/15', 'z-0');
						} else {
							card.classList.remove('scale-100', 'sm:scale-105', 'opacity-100', 'shadow-[0_20px_40px_rgba(0,109,55,0.14)]', 'border-[#006D37]/40', 'z-10');
							card.classList.add('scale-95', 'opacity-70', 'shadow-none', 'border-outline-variant/15', 'z-0');
						}
					});

					// Update Progress Bar (Percentage based on active card index)
					if (progressBar) {
						const progressPercent = cards.length > 0 ? Math.round(((activeIndex + 1) / cards.length) * 100) : 20;
						progressBar.style.setProperty('width', `${progressPercent}%`, 'important');
					}

					// Update Counter
					if (slideCounter) {
						const activeStr = String(activeIndex + 1).padStart(2, '0');
						const totalStr = String(cards.length).padStart(2, '0');
						slideCounter.innerHTML = `${activeStr} <span class="text-on-surface-variant/40 font-normal">/ ${totalStr}</span>`;
					}

					// Update Dots
					if (dotsContainer) {
						const dots = Array.from(dotsContainer.children);
						dots.forEach((dot, idx) => {
							if (idx === activeIndex) {
								dot.className = 'w-6 h-2 bg-[#006D37] rounded-full transition-all duration-300';
							} else {
								dot.className = 'w-2 h-2 bg-outline-variant/40 hover:bg-[#006D37]/60 rounded-full transition-all duration-300 cursor-pointer';
							}
						});
					}
				}

				// Click card directly to center it
				cards.forEach((card, idx) => {
					card.addEventListener('click', (e) => {
						if (!e.target.closest('a')) {
							resetInteractionDelay();
							scrollToCard(idx);
						}
					});
				});

				function autoScroll() {
					if (isUserInteracting) return;
					const nextIndex = (activeIndex + 1) % cards.length;
					scrollToCard(nextIndex);
				}

				function startAutoScroll() {
					stopAutoScroll();
					scrollInterval = setInterval(autoScroll, 4500);
				}

				function stopAutoScroll() {
					if (scrollInterval) clearInterval(scrollInterval);
				}

				function resetInteractionDelay() {
					isUserInteracting = true;
					stopAutoScroll();
					if (interactionTimeout) clearTimeout(interactionTimeout);
					interactionTimeout = setTimeout(() => {
						isUserInteracting = false;
						startAutoScroll();
					}, 6000);
				}

				prevBtn.addEventListener('click', () => {
					resetInteractionDelay();
					const prevIndex = activeIndex > 0 ? activeIndex - 1 : cards.length - 1;
					scrollToCard(prevIndex);
				});

				nextBtn.addEventListener('click', () => {
					resetInteractionDelay();
					const nextIndex = (activeIndex + 1) % cards.length;
					scrollToCard(nextIndex);
				});

				let ticking = false;
				container.addEventListener('scroll', () => {
					if (!ticking) {
						window.requestAnimationFrame(() => {
							updateActiveState();
							ticking = false;
						});
						ticking = true;
					}
				}, { passive: true });

				container.addEventListener('mouseenter', () => { 
					isUserInteracting = true; 
					stopAutoScroll(); 
				});
				container.addEventListener('mouseleave', () => { 
					isUserInteracting = false; 
					startAutoScroll(); 
				});
				container.addEventListener('touchstart', () => { 
					resetInteractionDelay();
				}, { passive: true });

				// Initial trigger
				updateActiveState();
				startAutoScroll();
			}

			// 3. Testimonial Slideshow Controller
			const tSlides = document.querySelectorAll('.testimonial-slide');
			const tDots = document.querySelectorAll('.t-dot');
			let activeT = 0;
			let testimonialInterval = null;

			function showTestimonial(index) {
				if (tSlides.length === 0) return;
				tSlides.forEach((slide, idx) => {
					if (idx === index) {
						slide.classList.remove('hidden');
						slide.classList.add('flex');
					} else {
						slide.classList.remove('flex');
						slide.classList.add('hidden');
					}
				});
				tDots.forEach((dot, idx) => {
					if (idx === index) {
						dot.classList.add('bg-secondary');
						dot.classList.remove('bg-on-primary/30');
					} else {
						dot.classList.remove('bg-secondary');
						dot.classList.add('bg-on-primary/30');
					}
				});
				activeT = index;
			}

			// Testimonial Autoplay logic (only if there are dots)
			if (tDots.length > 1) {
				testimonialInterval = setInterval(() => {
					let nextIdx = (activeT + 1) % tSlides.length;
					showTestimonial(nextIdx);
				}, 6000);
			}

			tDots.forEach((dot, idx) => {
				dot.addEventListener('click', () => {
					if (testimonialInterval) clearInterval(testimonialInterval);
					showTestimonial(idx);
				});
			});

			// 4. Scroll Reveal Intersection Observer
			const revealElements = document.querySelectorAll('.reveal-init');
			
			const observerOptions = {
				root: null,
				rootMargin: '0px 0px -80px 0px',
				threshold: 0.1
			};

			const revealObserver = new IntersectionObserver((entries, observer) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('reveal-active');
						observer.unobserve(entry.target);
					}
				});
			}, observerOptions);

			revealElements.forEach(element => {
				revealObserver.observe(element);
			});

			// 5. Video Player Modal Controller
			const indexVideoCards = document.querySelectorAll('.index-video-card');
			let indexVideoModal = null;

			indexVideoCards.forEach(card => {
				card.addEventListener('click', () => {
					const videoId = card.getAttribute('data-video-id') || 'dQw4w9WgXcQ';
					if (!indexVideoModal) {
						indexVideoModal = document.createElement('div');
						indexVideoModal.id = 'index-video-modal';
						indexVideoModal.className = 'fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 transition-all duration-300';
						indexVideoModal.innerHTML = `
							<div class="relative w-full max-w-4xl bg-black rounded-2xl overflow-hidden shadow-2xl border border-white/10">
								<button id="close-index-video-modal" class="absolute top-3 right-3 z-10 w-10 h-10 rounded-full bg-black/70 text-white flex items-center justify-center hover:bg-red-600 transition-colors cursor-pointer border-0">
									<span class="material-symbols-outlined text-xl">close</span>
								</button>
								<div class="relative aspect-video w-full">
									<iframe id="index-video-iframe" class="w-full h-full" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
								</div>
							</div>
						`;
						document.body.appendChild(indexVideoModal);

						indexVideoModal.querySelector('#close-index-video-modal').addEventListener('click', () => {
							indexVideoModal.classList.add('hidden');
							indexVideoModal.querySelector('#index-video-iframe').src = '';
						});

						indexVideoModal.addEventListener('click', (e) => {
							if (e.target === indexVideoModal) {
								indexVideoModal.classList.add('hidden');
								indexVideoModal.querySelector('#index-video-iframe').src = '';
							}
						});
					}

					indexVideoModal.querySelector('#index-video-iframe').src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
					indexVideoModal.classList.remove('hidden');
				});
			});
		});
	</script>
}
