					@if (Model.Testimonials != null && Model.Testimonials.Any())
					{
						@for (int i = 0; i < Model.Testimonials.Count; i++)
						{
							var t = Model.Testimonials[i];
							<div class="testimonial-slide @(i == 0 ? "flex" : "hidden") flex-col items-center transition-all duration-500" data-t-index="@i">
								<p class="text-on-primary font-headline-md text-base sm:text-xl md:text-headline-md italic mb-6 md:mb-8 leading-relaxed">"@t.Testimonial"</p>
								<div class="text-on-primary text-center">
									<p class="font-headline-md text-sm sm:text-body-lg font-bold">@t.TestimonialBy</p>
									<p class="font-body-md text-on-primary/70 text-xs sm:text-sm">@t.Occupation</p>
								</div>
							</div>
						}
					}
					else
					{
						<div class="testimonial-slide flex flex-col items-center" data-t-index="0">
							<p class="text-on-primary font-headline-md text-base sm:text-xl md:text-headline-md italic mb-6 md:mb-8 leading-relaxed">"NDDC Is A good place and they are trying"</p>
							<div class="text-on-primary text-center">
								<p class="font-headline-md text-sm sm:text-body-lg font-bold">Dagogo Tolofari</p>
