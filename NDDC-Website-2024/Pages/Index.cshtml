	<!-- News Point Section -->
	@{
		var newsList = Model.NewsList ?? new List<MyNewsModel>();
		var mainNews = newsList.FirstOrDefault();
		var otherNews = newsList.Skip(1).Take(4).ToList();
		
		string GetImageUrl(MyNewsModel news)
		{
			if (news == null || string.IsNullOrEmpty(news.ImageUrl)) return "https://lh3.googleusercontent.com/aida-public/AB6AXuBMCly9Q7Ibo8R3azeo0P3fvFhksh6QlS6LwxXGJv-6fX4Pt_o52shms7-s_iMhQYl4qBl5j1RRQkgJ-IOiK-Kv2PjndbLnx0LhSykLYECgRl1Zox5pWnkijLY-3zJpjV6nJ_UAuYXLGR4cClvc1oYSKVAp5lbEpq_Bd6vFsdKNlg4inIU-8oV1nfa3eYl6ps5BshN_5BAxgkq-ckWBNP9WJUWZxFSzqUup6mmyisDKkm6CgV-OSpM6gN7RgZiJqykkgk9qKnFH-S8";
			return news.ImageUrl.StartsWith("http") ? news.ImageUrl : $"{Model._containerUrl}{news.ImageUrl}";
		}
		
		var mainNewsImage = mainNews != null ? GetImageUrl(mainNews) : "";
	}

