@page
@using System.Web
@using System.Text.RegularExpressions
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Button trigger modal -->
<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal" id="click" style="display:none;">
	Launch modal
</button>

@{
	// Function to strip HTML tags from a string
	string StripHtml(string input)
	{
		return Regex.Replace(input, "<.*?>", string.Empty);
	}
}
<!-- Modal -->
@if (Model.Announcement != null)
{
	<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<h1 class="modal-title fs-5 text-success" id="exampleModalLabel">Public Announcement</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="card" style="border: 0;">
						<div class="card-body">
							<h5 class="card-title">@Model.Announcement.Title</h5>
							<p class="card-text">@Html.Raw(Model.Announcement.Details)</p>
							<a href="#" class="text-success pt-3">Learn more</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}


@if (Model.LiveEvent != null)
{
	<!--Live Events Section-->
	@if(Model.IsEventLive == false)
	{
		<section class="" style="background-color:#003b4952;">
			<div class="container-xxl mt-0" style="">
				<div class="row">
					<div class="col-lg-12 d-flex text-light px-5 py-3 justify-content-between align-items-center flex-wrap" style="background-color: #026DB5;">
						<p class="text-light fs-4 fw-bold mb-0">This event will be starting in:</p>
						<div><span class="lead fs-4 fw-bold pe-2 days"> </span><span class="lead fs-4 fw-bold pe-2">days</span></div>
						<div><span class="lead fs-4 fw-bold pe-2 hours"> </span><span class="lead fs-4 fw-bold pe-2">hours</span></div>
						<div><span class="lead fs-4 fw-bold pe-2 minutes"> </span><span class="lead fs-4 fw-bold pe-2">minutes</span></div>
						<div><span class="lead fs-4 fw-bold pe-2 seconds"> </span><span class="lead fs-4 fw-bold pe-2">seconds</span></div>



					</div>
					<div class="col-lg-5" style=" background-color:var(--thm-black);">
						<div class="mayor-box" style=" padding-right: 1rem;">
							<div class="section-title-box m-4">
								@if (Model.LiveEvent.StartDate.ToString("dd") == Model.LiveEvent.EndDate.ToString("dd"))
								{
									<div class="lead pb-4 fw-bold" style="  color: var(--thm-primary); text-transform: uppercase; letter-spacing: 1px;">

										@* NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd") - @Model.LiveEvent.EndDate.ToString("dd") *@
										NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd")
									</div>

									<!-- section-tagline -->
								}
								else
								{
									<div class="lead pb-4 fw-bold" style="  color: var(--thm-primary); text-transform: uppercase; letter-spacing: 1px;">

										@* NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd") *@
										NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd") - @Model.LiveEvent.EndDate.ToString("dd")
									</div>

									<!-- section-tagline -->
								}
								<h2 class="section-title mb-4 text-light" style="font-size: 40px;">
									@Model.LiveEvent.Title
								</h2>
								<p class="text-light">@Model.LiveEvent.Summary</p>
								<div class="d-flex pt-4">
									<a asp-route-Id="@Model.LiveEvent.Id" asp-page="/Media/LiveEvent/EventDetails" class="btn btn-primary px-3 py-2 me-3" style="">Learn More</a>
									<a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=@Model.LiveEvent.Title&details=More+help+visit:+https://nddc.gov.ng&dates=@Model.LiveEvent.StartDate.ToString("yyyyMMdd")T080000/@Model.LiveEvent.EndDate.ToString("yyyyMMdd")T170000&ctz=Nigeria" target="_blank" class="btn btn-success px-3 py-2 text-light fw-bold rounded-0"> <i class="fa-solid fa-calendar-days pe-2"></i>Calender</a>
								</div>
							</div><!--section-title-box-->
							<!--mayor-icon-box-->
							<!-- ul -->
						</div><!--mayor-box-->
					</div><div class="col-lg-7" style=" --bs-gutter-x: 0;">
						<div class="">
							<img src="@Model._containerUrl@Model.LiveEvent.BannerImage" alt="img-138" style="width: -webkit-fill-available;" class="mw-100" height="600">
						</div><!--mayor-img-->
					</div>


					<!--col-lg-6"-->
				</div><!-- row -->

			</div><!-- container -->
		</section>
	}
	else
	{
		<section class="" style="background-color:#003b4952;">
			<div class="container-xxl mt-0" style="">
				<div class="row">
					
					<div class="col-lg-5" style=" background-color:var(--thm-black);">
						<div class="mayor-box" style=" padding-right: 1rem;">
							<div class="section-title-box m-4">
								<div class="lead pb-4 fw-bold" style="  color: var(--thm-primary); text-transform: uppercase; letter-spacing: 1px;">
									NDDC LIVE EVENT | @Model.LiveEvent.StartDate.ToString("MMMM") @Model.LiveEvent.StartDate.ToString("dd") - @Model.LiveEvent.EndDate.ToString("dd")
								</div><!-- section-tagline -->
								<h2 class="section-title mb-4 text-light" style="font-size: 40px;">
									@Model.LiveEvent.Title
								</h2>
								<p class="text-light">@Model.LiveEvent.Summary</p>
								<div class="d-flex pt-4">
									<a asp-route-Id="@Model.LiveEvent.Id" asp-page="EventDetails" class="btn btn-primary px-3 py-2 me-3" style="">Learn More</a>
									<a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=@Model.LiveEvent.Title&details=More+help+visit:+https://nddc.gov.ng&dates=@Model.LiveEvent.StartDate.ToString("yyyyMMdd")T160000/@Model.LiveEvent.EndDate.ToString("yyyyMMdd")T170000&ctz=Nigeria" target="_blank" class="btn btn-success px-3 py-2 text-light fw-bold rounded-0"> <i class="fa-solid fa-calendar-days pe-2"></i>Calender</a>
								</div>
							</div><!--section-title-box-->
							<!--mayor-icon-box-->
							<!-- ul -->
						</div><!--mayor-box-->
					</div><div class="col-lg-7" style=" --bs-gutter-x: 0;">
