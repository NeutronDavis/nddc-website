@page
@model NDDC_Website_2024.Pages.IndexModel
@using NddcWebsiteLibrary.Model.Home
@{
	Layout = "_Layout";
}

<style>
	.about-two-section {
		padding-top: 3rem !important;
		padding-bottom: 3rem !important;
	}
	.about-two-image {
		display: block !important;
		width: 100% !important;
	}
	#imageHolder {
		width: 100% !important;
	}
	.imageHolderDiv {
		display: flex !important;
		gap: 12px !important;
		width: 100% !important;
	}
	.imageHolderDiv img {
		display: block !important;
		width: 15% !important;
		height: 18rem !important;
		max-width: none !important;
		flex-shrink: 0 !important;
		object-fit: cover !important;
		border-radius: 12px !important;
		transition: width 0.4s ease, filter 0.4s ease !important;
	}
	.imageHolderDiv img:hover {
		width: 37% !important;
	}
	@@media (max-width: 767px) {
		.imageHolderDiv {
			gap: 8px !important;
		}
		.imageHolderDiv img {
			height: 15rem !important;
			width: 17% !important;
			border-radius: 8px !important;
		}
		.imageHolderDiv img:hover {
			width: 32% !important;
		}
	}
	@@media (min-width: 768px) {
		.imageHolderDiv img {
			height: 28rem !important;
		}
	}

	/* Scroll Reveal Animations */
	.reveal-init {
		opacity: 0;
		transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform, opacity;
	}

	.reveal-fade-up {
		transform: translateY(40px);
	}

	.reveal-fade-left {
		transform: translateX(-40px);
	}

	.reveal-fade-right {
		transform: translateX(40px);
	}

	.reveal-scale {
		transform: scale(0.92);
	}

	.reveal-init.reveal-active {
		opacity: 1;
		transform: translate(0) scale(1);
	}

	.delay-100 { transition-delay: 100ms; }
	.delay-200 { transition-delay: 200ms; }
	.delay-300 { transition-delay: 300ms; }
	.delay-400 { transition-delay: 400ms; }

	/* Hero Slide Content Page Entrance Animation */
	@@keyframes slideUpFade {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-slide.opacity-100 .animate-hero-content > * {
		animation: slideUpFade 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.hero-slide.opacity-100 .animate-hero-content > *:nth-child(1) { animation-delay: 150ms; }
	.hero-slide.opacity-100 .animate-hero-content > *:nth-child(2) { animation-delay: 300ms; }
	.hero-slide.opacity-100 .animate-hero-content > *:nth-child(3) { animation-delay: 450ms; }
	.hero-slide.opacity-100 .animate-hero-content > *:nth-child(4) { animation-delay: 600ms; }
</style>

	<!-- Hero Carousel -->
	<section class="relative w-full h-[75vh] md:h-[calc(100vh-5rem)] min-h-[480px] md:min-h-[600px] bg-primary flex items-center justify-center overflow-hidden mt-20">
		@if (Model.NewsSlide != null && Model.NewsSlide.Any())
		{
			@for (int i = 0; i < Model.NewsSlide.Count; i++)
			{
				var slide = Model.NewsSlide[i];
				var slideImage = !string.IsNullOrEmpty(slide.ImageUrl) 
					? (slide.ImageUrl.StartsWith("http") ? slide.ImageUrl : $"{Model._containerUrl}{slide.ImageUrl}") 
					: "https://lh3.googleusercontent.com/aida-public/AB6AXuDVKDs9QFDoYC-J_Ga230U9uPORsK4Aw0--pwFgVD4cIWNehYuWXjT1WopKjn7Se9M9oPnBFMRGKPJ07Ot1Emon_PAQl29op2zSJtiKdb90-RWRxbGP0lv5kzYVx1R8bpAQ_CCFolx1ambVH6uSVXOtx3A1UjQOOxPuJUQXlgyWp1dqtBFmpdRcZkVqa8NG-smykmSP5moh2U4T0c-u7HTbJvIqT-oAIkYpLYWABiGhngTR6bCqEZc3ro-OSl3ncW2ezVQp5N69Xw4";
				<div class="absolute inset-0 w-full h-full hero-slide @(i == 0 ? "opacity-100 transition-all duration-1000" : "opacity-0 pointer-events-none transition-all duration-1000")" data-slide-index="@i">
					<img alt="Hero Image" class="absolute inset-0 object-cover object-top w-full h-full opacity-70" src="@slideImage">
					<div class="absolute inset-0 bg-gradient-to-r from-primary/85 via-primary/30 to-transparent"></div>
					<div class="relative z-10 max-w-container-max mx-auto px-6 md:px-gutter w-full h-full flex items-center">
						<div class="max-w-3xl flex flex-col justify-center items-start text-left animate-hero-content">
							<span class="inline-block font-label-sm text-[12px] md:text-label-sm text-secondary-fixed mb-3 md:mb-4 tracking-widest uppercase font-semibold">@(string.IsNullOrEmpty(slide.Type) ? "Niger Delta Development Commission" : slide.Type)</span>
							<h1 class="font-display-lg text-headline-lg-mobile md:text-display-lg text-on-primary mb-4 md:mb-6 leading-tight text-white font-bold text-left">@slide.Subject</h1>
							<p class="font-body-lg text-body-md md:text-body-lg text-on-primary/80 mb-6 md:mb-8 max-w-2xl">@slide.Summary</p>
							@if (slide.NID > 0)
							{
								<div class="flex space-x-4">
									<a asp-page="/News/NewsDetails" asp-route-nid="@slide.NID" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-label-sm text-label-sm px-6 py-3.5 md:px-8 md:py-4 rounded-full transition-all duration-300 shadow-lg hover:shadow-xl font-semibold">
										Explore Our Impact
									</a>
								</div>
							}
						</div>
					</div>
				</div>
			}
		}
		else
		{
			<div class="absolute inset-0 w-full h-full hero-slide opacity-100" data-slide-index="0">
				<img alt="Hero Image" class="absolute inset-0 object-cover object-top w-full h-full opacity-70" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDVKDs9QFDoYC-J_Ga230U9uPORsK4Aw0--pwFgVD4cIWNehYuWXjT1WopKjn7Se9M9oPnBFMRGKPJ07Ot1Emon_PAQl29op2zSJtiKdb90-RWRxbGP0lv5kzYVx1R8bpAQ_CCFolx1ambVH6uSVXOtx3A1UjQOOxPuJUQXlgyWp1dqtBFmpdRcZkVqa8NG-smykmSP5moh2U4T0c-u7HTbJvIqT-oAIkYpLYWABiGhngTR6bCqEZc3ro-OSl3ncW2ezVQp5N69Xw4">
				<div class="absolute inset-0 bg-gradient-to-r from-primary/85 via-primary/30 to-transparent"></div>
				<div class="relative z-10 max-w-container-max mx-auto px-6 md:px-gutter w-full h-full flex items-center">
					<div class="max-w-3xl flex flex-col justify-center items-start text-left animate-hero-content">
						<span class="inline-block font-label-sm text-[12px] md:text-label-sm text-secondary-fixed mb-3 md:mb-4 tracking-widest uppercase font-semibold">Niger Delta Development Commission</span>
						<h1 class="font-display-lg text-headline-lg-mobile md:text-display-lg text-on-primary mb-4 md:mb-6 leading-tight text-white font-bold text-left">Empowering Communities, Building the Future.</h1>
						<p class="font-body-lg text-body-md md:text-body-lg text-on-primary/80 mb-6 md:mb-8 max-w-2xl">Advancing social welfare initiatives and bolstering infrastructure to create lasting positive transformation across the Niger Delta region.</p>
						<div class="flex space-x-4">
							<a href="/WhoWeAre/Index" class="bg-secondary hover:bg-secondary/90 text-on-secondary font-label-sm text-label-sm px-6 py-3.5 md:px-8 md:py-4 rounded-full transition-all duration-300 shadow-lg hover:shadow-xl font-semibold">
								Explore Our Impact
							</a>
						</div>
					</div>
				</div>
			</div>
		}

		<!-- Carousel Indicators -->
		<div class="absolute bottom-6 md:bottom-12 left-1/2 -translate-x-1/2 flex space-x-3 z-20" id="hero-indicators">
			@if (Model.NewsSlide != null && Model.NewsSlide.Count > 1)
			{
				@for (int i = 0; i < Model.NewsSlide.Count; i++)
				{
					<button class="hero-dot h-1.5 rounded-full transition-all duration-300 @(i == 0 ? "w-12 bg-secondary" : "w-8 bg-on-primary/30 hover:bg-on-primary/50")" data-slide-to="@i"></button>
				}
			}
			else
			{
				<button class="hero-dot w-12 h-1.5 bg-secondary rounded-full"></button>
			}
		</div>
	</section>

	<!-- Icon Quick Links (Bento Grid Style) -->
