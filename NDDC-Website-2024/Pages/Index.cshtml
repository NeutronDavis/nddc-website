@functions {
	public static string GetYouTubeVideoId(string url)
	{
		if (string.IsNullOrWhiteSpace(url)) return "";
		url = url.Trim();
		if (url.Contains("youtube.com") || url.Contains("youtu.be"))
		{
			var regex = new System.Text.RegularExpressions.Regex(@"(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([^#\&\?]{11})", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
			var match = regex.Match(url);
			if (match.Success)
			{
				return match.Groups[1].Value;
			}
		}
		if (url.Contains("?"))
		{
			url = url.Split('?')[0];
		}
		if (url.Contains("/"))
		{
			url = url.Substring(url.LastIndexOf('/') + 1);
		}
		return url;
	}
}

<style>
	.about-two-section {
		padding-top: 3rem !important;
		padding-bottom: 3rem !important;
	}
	.about-two-image {
		display: block !important;
		width: 100% !important;
	}
	#imageHolder {
		width: 100% !important;
	}
	.imageHolderDiv {
		display: flex !important;
		gap: 12px !important;
		width: 100% !important;
	}
	.imageHolderDiv img {
		display: block !important;
		width: 15% !important;
		height: 18rem !important;
		max-width: none !important;
		flex-shrink: 0 !important;
		object-fit: cover !important;
		border-radius: 12px !important;
		transition: width 0.4s ease, filter 0.4s ease !important;
	}
	.imageHolderDiv img:hover {
		width: 37% !important;
	}
	@@media (max-width: 767px) {
		.imageHolderDiv {
			gap: 8px !important;
		}
		.imageHolderDiv img {
			height: 15rem !important;
			width: 17% !important;
			border-radius: 8px !important;
		}
