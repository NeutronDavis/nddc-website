			@{
				var allVideosList = Model.Videos != null && Model.Videos.Any() ? Model.Videos.Take(4).ToList() : new List<MyVideoModel>();
				var mainVideo = Model.MainVideo ?? allVideosList.FirstOrDefault();
				var mainTitle = mainVideo != null && !string.IsNullOrEmpty(mainVideo.VideoTitle) ? mainVideo.VideoTitle : "See Something, Say Something: Protecting NDDC Solar Streetlights in Rivers State";
				var mainUrl = mainVideo != null ? mainVideo.YoutubeUrl : "https://www.youtube.com/watch?v=dQw4w9WgXcQ";
				var mainVideoIdRaw = GetYouTubeVideoId(mainUrl);
				var mainVideoId = !string.IsNullOrEmpty(mainVideoIdRaw) ? mainVideoIdRaw : "dQw4w9WgXcQ";

				var sideVideos = allVideosList.Where(v => v != mainVideo).Take(3).ToList();
			}

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 md:gap-6 items-stretch">
				<!-- Main Featured Video (Left 2 Columns) -->
				<div class="lg:col-span-2 relative rounded-2xl overflow-hidden shadow-lg group cursor-pointer aspect-video bg-black flex items-center justify-center index-video-card" data-video-id="@mainVideoId" title="@mainTitle">
					<img src="https://img.youtube.com/vi/@mainVideoId/hqdefault.jpg" alt="@mainTitle" class="absolute inset-0 w-full h-full object-cover opacity-85 group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://images.unsplash.com/photo-1541888946425-d0fbb186a5b7?q=80&w=1200&auto=format&fit=crop'">
					<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/60"></div>
					
					<!-- Top Title Overlay -->
					<div class="absolute top-4 left-4 right-4 z-10 flex items-center gap-3">
						<div class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
							<span class="material-symbols-outlined text-base">video_library</span>
						</div>
						<h3 class="text-white font-bold text-sm sm:text-base md:text-lg line-clamp-2 drop-shadow-md">@mainTitle</h3>
					</div>

					<!-- Green Center Play Button (Matching Website Brand Color) -->
					<div class="relative z-10 w-16 h-12 sm:w-20 sm:h-14 bg-[#006D37] hover:bg-[#005229] rounded-2xl flex items-center justify-center shadow-xl group-hover:scale-110 transition-all duration-300">
						<svg class="w-8 h-8 text-white fill-current ml-1" viewBox="0 0 24 24">
							<path d="M8 5v14l11-7z"/>
						</svg>
					</div>

					<!-- Bottom Right "Watch on YouTube" Pill -->
					<div class="absolute bottom-4 right-4 z-10 bg-black/80 backdrop-blur-md text-white text-xs font-semibold px-3 py-1.5 rounded-lg flex items-center gap-1.5 border border-white/10 shadow-md">
						<span>Watch on</span>
						<span class="font-bold text-red-500 flex items-center gap-0.5">
							<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816zm-10.615 12.816v-8l8 4-8 4z"/></svg> YouTube
						</span>
					</div>
				</div>

				<!-- Secondary Side Videos (Right 1 Column) -->
				<div class="lg:col-span-1 flex flex-col gap-4 justify-between">
					@if (sideVideos.Any())
					{
						@foreach (var sv in sideVideos)
						{
							var svIdRaw = GetYouTubeVideoId(sv.YoutubeUrl);
							var svId = !string.IsNullOrEmpty(svIdRaw) ? svIdRaw : "dQw4w9WgXcQ";
							<div class="relative rounded-xl overflow-hidden shadow-md group cursor-pointer aspect-video bg-black flex items-center justify-center index-video-card" data-video-id="@svId" title="@sv.VideoTitle">
								<img src="https://img.youtube.com/vi/@svId/hqdefault.jpg" alt="@sv.VideoTitle" class="absolute inset-0 w-full h-full object-cover opacity-85 group-hover:scale-105 transition-transform duration-500">
								<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/60"></div>
								<div class="absolute top-3 left-3 right-3 z-10 flex items-center gap-2">
									<div class="w-6 h-6 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white text-[10px]">
										<span class="material-symbols-outlined text-xs">play_circle</span>
									</div>
									<h4 class="text-white font-bold text-xs sm:text-sm line-clamp-1 drop-shadow-md">@sv.VideoTitle</h4>
								</div>
								<div class="relative z-10 w-12 h-9 bg-[#006D37] hover:bg-[#005229] rounded-xl flex items-center justify-center shadow-md group-hover:scale-110 transition-all duration-300">
									<svg class="w-6 h-6 text-white fill-current ml-0.5" viewBox="0 0 24 24">
										<path d="M8 5v14l11-7z"/>
									</svg>
								</div>
							</div>
						}
					}
					else
					{
						<!-- SVG Empty State when no side videos are available -->
						<div class="h-full flex flex-col items-center justify-center p-8 text-center bg-surface-container-lowest rounded-xl border border-dashed border-outline-variant/40 min-h-[240px]">
							<div class="w-14 h-14 rounded-full bg-[#006D37]/10 flex items-center justify-center text-[#006D37] mb-3">
								<svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
									<path d="M21 6.5l-4 3.2V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-2.7l4 3.2c.38.3.9.03.9-.46V6.96c0-.49-.52-.76-.9-.46zM15 16H5V8h10v8z"/>
								</svg>
							</div>
							<h4 class="text-sm font-bold text-primary mb-1">No Additional Videos</h4>
							<p class="text-xs text-on-surface-variant/70 max-w-xs leading-relaxed">More video updates from our regional activities will be published here soon.</p>
						</div>
					}
				</div>
			</div>

			<!-- View More Videos CTA Button -->
			<div class="mt-8 sm:mt-10 text-center">
				<a href="/Media/Videos" class="inline-flex items-center gap-2 bg-[#006D37] hover:bg-[#005229] text-white font-bold text-xs sm:text-sm px-8 py-3.5 rounded-full shadow-md hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5 group">
					<span>View More Videos</span>
					<span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
				</a>
			</div>
		</div>
	</section>

