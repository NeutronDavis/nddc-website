}

<section class="" style="background-color:#003b4952;">
	<div class="container mt-0" style="">
		<div class="row justify-content-center">
			<div class="col-lg-8" style=" --bs-gutter-x: 0;">
				<div class="">
					<img src="@Model._containerUrl@Model.EventDetails.BannerImage" alt="img-138" class="mw-100" height="400" style="width: -webkit-fill-available;">
