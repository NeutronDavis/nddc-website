<section class="cta-three-section mt-5">
	<div class="container">
		<div id="carouselProjectSlides" class="carousel slide" data-bs-ride="carousel">
		  <div class="carousel-inner">
			@{ int _psi = 0; var _projectCount = Model.ProjectImageSlide.Count(); }
			@foreach (var item in Model.ProjectImageSlide)
				{
					<div class="carousel-item @(_psi == 0 ? "active" : "")">
						<div class="img-shimmer-wrap w-100">
							<img src="@Model._containerUrl@item.DescriptionImage"
								 class="d-block w-100 img-fade"
								 width="1200" height="600"
								 alt="@item.Title"
								 loading="@(_psi == 0 ? "eager" : "lazy")"
								 fetchpriority="@(_psi == 0 ? "high" : "auto")">
						</div>
						<div class="carousel-caption d-none d-md-block">
							<h5 class="text-white">@item.Title</h5>
							<p class="text-white">@item.ProjectProgramType</p>
						</div>
					</div>
					_psi++;
				}
		  </div>
		  <button class="carousel-control-prev" type="button" data-bs-target="#carouselProjectSlides" data-bs-slide="prev">
			<span class="carousel-control-prev-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Previous</span>
		  </button>
		  <button class="carousel-control-next" type="button" data-bs-target="#carouselProjectSlides" data-bs-slide="next">
			<span class="carousel-control-next-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Next</span>
		  </button>
		</div>
		<div class="carousel-bottom-bar">
			<div class="d-flex gap-2">
				@{ int _di = 0; }
				@foreach (var item in Model.ProjectImageSlide)
				{
					<button class="carousel-dot @(_di == 0 ? "carousel-dot--active" : "")"
							data-bs-target="#carouselProjectSlides"
							data-bs-slide-to="@_di"
							aria-label="Slide @(_di + 1)"></button>
					_di++;
				}
			</div>
			<span class="carousel-slide-label"
				  data-carousel-label="carouselProjectSlides"
				  data-carousel-total="@_projectCount">1 / @_projectCount</span>
		</div>
	</div>
</section>


