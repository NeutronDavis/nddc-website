@page
@model NDDC_Website_2024.Pages.WhatWeDo.ScholarshipModel
@{
    Layout = "_Layout";
}

<style>
    .image-structure-ring {
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
    }
</style>

<!-- Hero / Breadcrumb Section -->
<section class="bg-surface-container py-8 sm:py-12 md:py-section-gap-sm px-4 sm:px-margin-mobile md:px-gutter">
    <div class="max-w-container-max mx-auto text-left">
        <nav class="flex flex-wrap items-center gap-2 mb-4 md:mb-stack-gap text-xs sm:text-label-sm font-label-sm text-on-surface-variant">
            <a class="hover:text-primary transition-colors" href="/">Home</a>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-on-surface-variant">What We Do</span>
            <span class="material-symbols-outlined text-[14px] sm:text-[16px] text-on-surface-variant/50">chevron_right</span>
            <span class="text-primary font-semibold">Scholarships</span>
        </nav>
        <h1 class="font-display-lg text-3xl sm:text-5xl md:text-display-lg tracking-tight font-bold text-left text-primary leading-tight">
            Scholarships
        </h1>
        <div class="w-16 sm:w-24 h-1 sm:h-1.5 bg-secondary mt-4 sm:mt-6 rounded-full"></div>

        <!-- Navigation Tabs -->
        <div class="mt-8 flex flex-wrap gap-3 border-b border-outline-variant/30 pb-3">
            <a href="/WhatWeDo/Scholarship" class="px-5 py-2.5 rounded-full text-sm font-semibold bg-primary text-white shadow-sm flex items-center gap-2">
                <span class="material-symbols-outlined text-base">campaign</span>
                Active Announcement
            </a>
            <a href="/WhatWeDo/ScholarshipHistory" class="px-5 py-2.5 rounded-full text-sm font-semibold text-on-surface-variant hover:text-primary hover:bg-surface-container-high transition-all flex items-center gap-2">
                <span class="material-symbols-outlined text-base">photo_library</span>
                History & Photo Archive
            </a>
        </div>
    </div>
</section>

<!-- Scholarship Content Section -->
<section class="py-section-gap-lg px-margin-mobile md:px-gutter max-w-container-max mx-auto">
    <div class="flex flex-col items-center">
        <!-- Announcement Document -->
        <div class="w-full max-w-4xl relative group">
            <div class="absolute -inset-1 bg-gradient-to-b from-primary/5 to-transparent rounded-xl blur-lg opacity-25 group-hover:opacity-40 transition-opacity"></div>
            <div class="relative bg-white p-4 md:p-8 rounded-xl border border-outline-variant/20 shadow-sm overflow-hidden image-structure-ring">
                <img alt="NDDC Scholarship Announcement 2026/2027" class="w-full h-auto rounded-lg transition-transform duration-700 group-hover:scale-[1.01]" src="/assets/image/NDDC-local-3.png">
            </div>
        </div>
        
        <!-- CTA Section -->
        <div class="mt-section-gap-sm flex flex-col sm:flex-row items-center justify-center gap-4 text-center">
            <a href="https://scholarship.nddc.gov.ng/login" target="_blank" class="group relative inline-flex items-center justify-center px-12 py-5 font-headline-md text-headline-md bg-secondary text-on-secondary rounded-full overflow-hidden transition-all hover:pr-16 active:scale-95 shadow-lg shadow-secondary/20 font-bold">
                <span class="relative z-10 transition-all duration-300 group-hover:-translate-x-2">Apply Now</span>
                <span class="absolute right-6 opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                    <span class="material-symbols-outlined text-white">arrow_forward</span>
                </span>
            </a>
            <a href="/WhatWeDo/ScholarshipHistory" class="inline-flex items-center justify-center px-8 py-5 text-sm font-bold text-primary bg-surface-container hover:bg-surface-container-high border border-outline-variant/30 rounded-full transition-all gap-2">
                <span class="material-symbols-outlined text-base">photo_library</span>
                <span>Past Scholarship Archive</span>
            </a>
        </div>
    </div>
</section>