@page "{nid:int?}"
@using System.Web
@using System.Text.RegularExpressions
@model NDDC_Website_2024.Pages.News.NewsDetailsModel
@{
    var _ndRawUrl  = $"{Request.Scheme}://{Request.Host}/News/NewsDetails/{Model.NewsDetails.NID}";
    var _ndUrl     = Uri.EscapeDataString(_ndRawUrl);
    var _ndTitle   = Uri.EscapeDataString(Model.NewsDetails.Subject ?? "");
    var _plainText = Regex.Replace(Model.NewsDetails.Details ?? "", "<[^>]+>", " ");
    var _readMins  = Math.Max(1, Regex.Matches(_plainText, @"\w+").Count / 200);
}

<div id="fb-root"></div>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_GB/sdk.js#xfbml=1&version=v19.0" nonce="ijI1VuoW"></script>

<nav style="--bs-breadcrumb-divider: '>';" aria-label="breadcrumb">
    <ol class="breadcrumb bg-dark list-unstyled justify-content-end border-bottom p-2 pe-5" style="--bs-bg-opacity: .1;">
        <li class="breadcrumb-item">
            <a href="/News/News" style="font-size: smaller; color: #003b49;">News</a>
        </li>
        <li class="breadcrumb-item" style="font-size: smaller; color: #003b49;">News Details</li>
    </ol>
</nav>

<section class="news-details-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <!-- ── Hero ─────────────────────────────────────────── -->
                <div class="nd-hero-wrap">
                    <img src="@Model._containerUrl@Model.NewsDetails.ImageUrl"
                         class="w-100"
                         alt="@Model.NewsDetails.Subject">
                    <div class="nd-hero-gradient"></div>
                    <h2 class="nd-hero-title">@Model.NewsDetails.Subject</h2>
                    <span class="nd-date-badge">
                        <i class="fa-regular fa-calendar me-1"></i>@Model.NewsDetails.PublishDate.ToString("dd MMM yyyy")
                    </span>
                </div>

                <!-- ── Meta strip ────────────────────────────────────── -->
                <div class="nd-meta-strip">
                    <span><i class="fa-solid fa-pen-nib"></i> Corporate Affairs Dept.</span>
                    <span><i class="fa-regular fa-clock"></i> @_readMins min read</span>
                    <a href="/News/News" class="ms-auto nd-back-link">
                        <i class="fa-solid fa-arrow-left me-1"></i>Back to News
                    </a>
                </div>

                <!-- ── Article body ──────────────────────────────────── -->
                <div class="nd-article-body">
                    <div class="nd-summary">
                        @Html.Raw(Model.NewsDetails.Summary)
                    </div>
                    <div class="nd-details">
                        @Html.Raw(Model.NewsDetails.Details)
                    </div>
                </div>

                <!-- ── Share strip ───────────────────────────────────── -->
                <div class="nd-share-strip">
                    <span class="nd-share-label">
                        <i class="fa-solid fa-share-nodes me-1"></i>Share
                    </span>
                    <a href="https://twitter.com/intent/tweet?url=@_ndUrl&amp;text=@_ndTitle"
                       target="_blank" rel="noopener"
                       class="nd-share-btn nd-share-btn--twitter">
                        <i class="fa-brands fa-x-twitter"></i> Twitter
                    </a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@_ndUrl"
                       target="_blank" rel="noopener"
                       class="nd-share-btn nd-share-btn--facebook">
                        <i class="fa-brands fa-facebook"></i> Facebook
                    </a>
                    <a href="https://www.linkedin.com/sharing/share-offsite/?url=@_ndUrl"
                       target="_blank" rel="noopener"
                       class="nd-share-btn nd-share-btn--linkedin">
                        <i class="fa-brands fa-linkedin"></i> LinkedIn
                    </a>
                    <a href="https://wa.me/?text=@_ndTitle%20@_ndUrl"
                       target="_blank" rel="noopener"
                       class="nd-share-btn nd-share-btn--whatsapp">
                        <i class="fa-brands fa-whatsapp"></i> WhatsApp
                    </a>
                    <a href="https://www.instagram.com/nddconline/"
                       target="_blank" rel="noopener"
                       class="nd-share-btn nd-share-btn--instagram">
                        <i class="fa-brands fa-instagram"></i> Instagram
                    </a>
                    <button type="button"
                            class="nd-share-btn nd-share-btn--copy nd-copy-btn"
                            data-url="@_ndRawUrl">
                        <i class="fa-regular fa-copy"></i> Copy Link
                    </button>
                </div>

                <!-- ── Photo gallery ─────────────────────────────────── -->
                @if (Model.PhotoGallery.Any())
                {
                    <h3 class="nd-gallery-heading">Photo Gallery</h3>
                    <div class="row g-3">
                        @foreach (var item in Model.PhotoGallery)
                        {
                            <div class="col-lg-4 col-md-4 col-6">
                                <div class="nd-gallery-item">
                                    <img src="@Model._containerUrl@item.ImageUrl"
                                         class="img-fluid w-100"
                                         alt="Gallery Image" loading="lazy">
                                    <div class="nd-gallery-overlay">
                                        <i class="fa-solid fa-magnifying-glass-plus"></i>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</section>

<script>
(function () {
    var btn = document.querySelector('.nd-copy-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
        navigator.clipboard.writeText(btn.dataset.url).then(function () {
            var orig = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
            setTimeout(function () { btn.innerHTML = orig; }, 2000);
        });
    });
}());
</script>
