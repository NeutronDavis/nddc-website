@page "{Id:int?}"
@model NDDC_Website_2024.Pages.News.AnnouncementDetailsModel
@{
}

<nav class="" style="--bs-breadcrumb-divider: '>';" @* style="top: 0px; right: 40px; position: absolute; " *@ aria-label="breadcrumb">
	<ol class="breadcrumb bg-dark list-unstyled justify-content-end p-2 pe-5 border-bottom" style="--bs-bg-opacity: .1;">
		<li class="breadcrumb-item">
			<a asp-page="Announcements" style="font-size: smaller;color: #003b49;">Announcements</a>
		</li>
		<li class="breadcrumb-item" style="font-size: smaller;color: #003b49;">Announcement Details</li>
	</ol><!-- list-unstyled -->
</nav>

<section class="news-details-section pt-0">
	<div class="container">
		<div class="row justify-content-center">
				<div class="col-lg-10">
					<div class="news-details-meta-box">
						<div class="news-details-meta-box-inner">
							<span class="author">
								Announced on:<a href="news-details.html">@Model.Details.StartDate.ToString("dd/MM/yy")</a>
							</span><!-- author -->
						</div><!-- news-details-meta-box-inner -->
					</div><!-- news-details-meta-box -->
					<div class="news-details-content-box">
					<h3>@Model.Details.Title</h3>
					<p>@Html.Raw(Model.Details.Details)</p>
					</div><!-- /.news-details-content-box -->
					<div class="news-details-share-box">
						<div class="news-details-inner justify-content-end">
							<div class="news-details-list">
								<!-- news-details-list-title -->
							</div><!--news-details-list-->
							<!-- news-details-list -->
						</div><!-- news-details-inner -->
					</div>
				</div>
		</div><!-- row -->
	</div><!-- container -->
</section>